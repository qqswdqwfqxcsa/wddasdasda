    local pos = hrp.Position
    for _, entry in ipairs(ae:GetChildren()) do
        if entry:GetAttribute("Egg") == eggName then
            local entryPos = entry:GetAttribute("Position")
            local match = false
            if typeof(entryPos) == "Vector3" then
                match = (entryPos - pos).Magnitude < 80
            elseif typeof(entryPos) == "CFrame" then
                match = (entryPos.Position - pos).Magnitude < 80
            end
            if match and entry:GetAttribute("VolcanoDipped") == true then
                return true
            end
        end
    end
    return false
end

function MystrixHub.Functions.FindBestRetrievableEgg(plot, petSpeed)
    local renderedEggs = Workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return nil end

    local plotCenter = plot:FindFirstChild("CenterPoint")
    local plotPos = plotCenter and plotCenter.Position or plot:GetPivot().Position

    local AssetsDir = MystrixHub.Functions.LoadAssetsDirectory()
    local selectedMutations = MystrixHub.AutoFarmController.SelectedMutations

    local EggBreakTimer = {
        Common = 20, Rare = 25, Epic = 35, Legendary = 30,
        Mythic = 30, Divine = 25, Ethereal = 22,
    }
    local RarityTier = {
        Common = 1, Rare = 2, Epic = 3, Legendary = 4,
        Mythic = 5, Divine = 6, Ethereal = 7,
    }

    local candidates = {}
    for _, eggModel in ipairs(renderedEggs:GetChildren()) do
        if eggModel:IsA("Model")
           and not eggModel:GetAttribute("MystrixStaged") then
            if MystrixHub.Functions.EggPassesMutationFilter(eggModel, selectedMutations) then
                local rarityName = nil

                if AssetsDir and AssetsDir[eggModel.Name] then
                    local r = AssetsDir[eggModel.Name].Rarity
                    if type(r) == "table" then
                        rarityName = r.DisplayName or r._id or r.Name
                    elseif type(r) == "string" then
                        rarityName = r
                    end
                end

                if not rarityName then
                    local nm = eggModel.Name:lower()
                    if nm:find("cherub") or nm:find("blackhole") or nm:find("giant") or nm:find("dragon") or nm:find("solaris") then
                        rarityName = "Ethereal"
                    elseif nm:find("aurora") or nm:find("galaxy") then
                        rarityName = "Divine"
                    elseif nm:find("skull") or nm:find("asteroid") or nm:find("dominus") or nm:find("flaming") or nm:find("sinister") or nm:find("soul") or nm:find("crystal") or nm:find("diamond") then
                        rarityName = "Mythic"
                    elseif nm:find("glass") or nm:find("golden") then
                        rarityName = "Legendary"
                    elseif nm:find("mushroom") or nm:find("flower") or nm:find("slime") or nm:find("ice") then
                        rarityName = "Epic"
                    elseif nm:find("cracked") or nm:find("easter") or nm:find("stone") or nm:find("leaf") then
                        rarityName = "Rare"
                    else
                        rarityName = "Common"
                    end
                end

                local breakTime = EggBreakTimer[rarityName]
                local tier = RarityTier[rarityName] or 0
                if breakTime then
                    local eggPos = eggModel:GetPivot().Position
                    local distance = (eggPos - plotPos).Magnitude
                    local travelTime = distance / math.max(petSpeed, 1)
                    table.insert(candidates, {
                        model = eggModel, name = eggModel.Name, rarity = rarityName,
                        tier = tier, breakTime = breakTime, distance = distance, travelTime = travelTime,
                    })
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        return a.distance < b.distance
    end)

    local margin = MystrixHub.AutoFarmController.Config.SafetyMargin
    for _, c in ipairs(candidates) do
        if c.travelTime <= (c.breakTime - margin) then return c end
    end
    return nil
end

