function MystrixHub.Functions.EggPetWebhook_Tick()
    local C = MystrixHub.EggPetWebhookController

    if C.EggEnabled and #C.EggFilter > 0 then
        local containers = {
            LocalPlayer:FindFirstChild("Basket"),
            LocalPlayer:FindFirstChild("Backpack"),
            LocalPlayer.Character,
        }
        for _, cont in ipairs(containers) do
            if cont then
                for _, child in ipairs(cont:GetChildren()) do
                    if not C.TrackedEggs[child] and child:GetAttribute("Egg") then
                        C.TrackedEggs[child] = true
                        local eggName = child:GetAttribute("Egg")
                        if table.find(C.EggFilter, eggName) then
                            local mutation = child:GetAttribute("Mutation")
                                or child:GetAttribute("EggMutation")
                                or child:GetAttribute("Mut")
                                or "None"
                            if mutation == "" then mutation = "None" end
                            local mutOk = table.find(C.EggMutationFilter, "Any") ~= nil
                                or table.find(C.EggMutationFilter, mutation) ~= nil
                            if mutOk then
                                task.spawn(function()
                                    MystrixHub.Functions.SendEggWebhook(eggName, mutation)
                                end)
                            end
                        end
                    end
                end
            end
        end
        for inst in pairs(C.TrackedEggs) do
            if not inst.Parent then C.TrackedEggs[inst] = nil end
        end
    end

    if C.PetEnabled and #C.PetFilter > 0 then
        local filterLookup = {}
        for _, n in ipairs(C.PetFilter) do
            if type(n) == "string" and n ~= "" then
                filterLookup[n:lower()] = true
            end
        end

        local mutLookup = {}
        local mutAny = false
        for _, m in ipairs(C.PetMutationFilter) do
            if type(m) == "string" then
                if m == "Any" then mutAny = true end
                mutLookup[m:lower()] = true
            end
        end

        local containers = {
            LocalPlayer:FindFirstChild("Backpack"),
            LocalPlayer.Character,
        }
        for _, cont in ipairs(containers) do
            if cont then
                for _, child in ipairs(cont:GetChildren()) do
                    if child:IsA("Tool") then
                        local petKey = child:GetAttribute("PetKey")
                        if petKey and petKey ~= "" and not C.TrackedPets[petKey] then
                            C.TrackedPets[petKey] = true

                            local baseName = child:GetAttribute("PetName")
                            if not baseName or baseName == "" then
                                baseName = child.Name:match("^([^%[]+)")
                                if baseName then baseName = baseName:match("^%s*(.-)%s*$") end
                                baseName = baseName or child.Name
                            end

                            local fullName = child.Name

                            if filterLookup[baseName:lower()] or filterLookup[fullName:lower()] then
                                local mutation = child:GetAttribute("Mutation")
                                    or child:GetAttribute("MutationType")
                                    or child:GetAttribute("Mut")
                                    or "None"
                                if mutation == "" then mutation = "None" end
                                local mutOk = mutAny or mutLookup[mutation:lower()] == true
                                if mutOk then
                                    task.spawn(function()
                                        MystrixHub.Functions.SendPetWebhook(baseName, mutation)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

