function MystrixHub.Functions.RestoreFromTween()
    local A = MystrixHub.AutoFarmController
    if not A.TweenState then return end

    if A.TweenState.conn then
        pcall(function() A.TweenState.conn:Disconnect() end)
    end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function()
            humanoid.PlatformStand = A.TweenState.oldPlatformStand == true
            humanoid.WalkSpeed     = tonumber(A.TweenState.oldWalkSpeed) or 16
            humanoid.AutoRotate    = A.TweenState.oldAutoRotate ~= false
        end)
    end

    local root = char and humanoid and humanoid.RootPart
    if root then
        pcall(function()
            root.AssemblyLinearVelocity  = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    MystrixHub.Functions.SetNoclip(false)
    A.TweenState = nil
end

function MystrixHub.Functions.KillMountVelocity()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, c in ipairs(hrp:GetChildren()) do
        if c:IsA("LinearVelocity") or c:IsA("AlignOrientation") or c:IsA("AlignPosition") then
            pcall(function() c:Destroy() end)
