function MystrixHub.Functions.StartInstantKill()
    local C = MystrixHub.InstantKillController
    if C._hooked then
        C.Enabled = true
        return
    end
    if type(hookfunction) ~= "function" then
        WindUI:Notify({ Title = "Instant Kill", Content = "Executor does not support hookfunction.", Duration = 4, Icon = "alert-circle" })
        return
    end
    local ok, HPCTRL = pcall(function() return require(game:GetService("ReplicatedStorage").CTRL.HPCTRL) end)
    if not ok or type(HPCTRL) ~= "table" or type(HPCTRL.DamageOnce) ~= "function" then
        WindUI:Notify({ Title = "Instant Kill", Content = "Failed to load HPCTRL module.", Duration = 4, Icon = "alert-circle" })
        return
    end
    C._orig.DamageOnce = hookfunction(HPCTRL.DamageOnce, function(target, dmg, ...)
        if C.Enabled and target and target.PrimaryPart and target.PrimaryPart:HasTag("Enemy") then
            dmg = 1e300
        end
        return C._orig.DamageOnce(target, dmg, ...)
    end)
    C._hooked = true
    C.Enabled = true
end

function MystrixHub.Functions.StopInstantKill()
    MystrixHub.InstantKillController.Enabled = false
end

