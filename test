function MystrixHub.Functions.Sell_InstallHook()
    local S = MystrixHub.SellController
    if S.DialogConnection then return end

    local R = MystrixHub.Functions.Sell_GetRemotes()
    if not R or not R.Send or not R.Select then
        return
    end

    S.DialogConnection = R.Send.OnClientEvent:Connect(function(arguments)
        if not arguments or not arguments.Options or #arguments.Options == 0 then return end
        if not S.AutoSellEnabled and not S.Running then return end
        if not arguments.Model then return end

        local mode = S.PendingMode or "single"

        if mode == "all" then
            for _, opt in ipairs(arguments.Options) do
                local t = tostring(opt.Text or ""):lower()
                if t:find("all") and t:find("sell") then
                    task.wait(0.25)
                    S.LastPick = opt.Text
                    R.Select:FireServer(arguments.Model, opt.Text)
                    return
                end
            end
        end

        for _, opt in ipairs(arguments.Options) do
            local t = tostring(opt.Text or ""):lower()
            if t:find("sell") and not (t:find("all")) then
                task.wait(0.25)
                S.LastPick = opt.Text
                R.Select:FireServer(arguments.Model, opt.Text)
                return
            end
        end

        for _, opt in ipairs(arguments.Options) do
            local t = tostring(opt.Text or ""):lower()
            if t:find("sell") then
                task.wait(0.25)
                S.LastPick = opt.Text
                R.Select:FireServer(arguments.Model, opt.Text)
                return
            end
        end
    end)

    if R.Update and not S.UpdateConnection then
        S.UpdateConnection = R.Update.OnClientEvent:Connect(function(payload)
            if not payload or not payload.Text then return end
            local money = tostring(payload.Text):match("%$([%d,]+)")
            if money then
            end
        end)
    end
end

