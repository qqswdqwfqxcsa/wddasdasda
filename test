end

function MystrixHub.Functions.FindBestPlaceableEgg()
    local candidates = {}
    for _, tool in ipairs(MystrixHub.Functions.GatherEggTools()) do
        local name = MystrixHub.Functions.EggToolBaseName(tool)
        local score = MystrixHub.Functions.GetEggScore(name)
        table.insert(candidates, { tool = tool, name = name, tier = score.tier, luck = score.luck })
    end
    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        if a.luck ~= b.luck then return a.luck > b.luck end
        return a.name < b.name
    end)
    return candidates[1]
end

function MystrixHub.Functions.FindSelectedPlaceableEgg()
    local M = MystrixHub.MainController
    if not M.PlaceSelectedEggs or #M.PlaceSelectedEggs == 0 then return nil end

    local wanted = {}
    for _, n in ipairs(M.PlaceSelectedEggs) do wanted[n:lower()] = true end

    local candidates = {}
    for _, tool in ipairs(MystrixHub.Functions.GatherEggTools()) do
        local name = MystrixHub.Functions.EggToolBaseName(tool)
        if wanted[name:lower()] then
            local score = MystrixHub.Functions.GetEggScore(name)
            table.insert(candidates, { tool = tool, name = name, tier = score.tier, luck = score.luck })
        end
    end
    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        if a.luck ~= b.luck then return a.luck > b.luck end
        return a.name < b.name
    end)
    return candidates[1]
end

function MystrixHub.Functions.StartAutoPlace()
    local M = MystrixHub.MainController
    if M.AutoPlaceLoop then return end

    local RS = game:GetService("ReplicatedStorage")
    local remotes = RS:FindFirstChild("Remotes")
    local gameFolder = remotes and remotes:FindFirstChild("Game")
    local eggPlaced = gameFolder and gameFolder:FindFirstChild("EggPlaced")

    M.AutoPlaceLoop = task.spawn(function()
        while M.AutoPlaceBest or M.AutoPlaceSelected do
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if not char or not humanoid or not eggPlaced then
                task.wait(1)
            else
                local plot = MystrixHub.Functions.GetMyPlot(true)
                local placedCount = MystrixHub.Functions.CountPlacedEggs(plot)

                if placedCount >= 10 then
                    task.wait(2)
                else
                    pcall(function() humanoid:UnequipTools() end)
                    task.wait(0.2)

                    local pick = nil
                    if M.AutoPlaceSelected then
                        pick = MystrixHub.Functions.FindSelectedPlaceableEgg()
                    end
                    if not pick and M.AutoPlaceBest then
                        pick = MystrixHub.Functions.FindBestPlaceableEgg()
                    end

                    if not pick then
                        task.wait(2)
                    else
                        local pos = MystrixHub.Functions.GetFreePlacementPosition(plot)
                        if not pos then
                            task.wait(2)
                        else
                            pcall(function() humanoid:EquipTool(pick.tool) end)
                            task.wait(0.35)

                            pcall(function()
                                eggPlaced:FireServer({
                                    PlantPosition = Vector3.new(pos.X, pos.Y, pos.Z),
                                })
                            end)
                            task.wait(0.4)

                            pcall(function() humanoid:UnequipTools() end)
                            task.wait(0.3)
                        end
                    end
                end
            end

            task.wait(0.5)
        end
        M.AutoPlaceLoop = nil
    end)
    MystrixHub.TasksController.Insert(M.AutoPlaceLoop)
end

function MystrixHub.Functions.StopAutoPlace()
    local M = MystrixHub.MainController
    M.AutoPlaceBest = false
    M.AutoPlaceSelected = false
    if M.AutoPlaceLoop then
        task.cancel(M.AutoPlaceLoop)
        M.AutoPlaceLoop = nil
    end
end

