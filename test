PerformanceSection:Toggle({
    Title    = "Hide Players",
    Value    = false,
    Flag     = "HidePlayers",
    Callback = function(state)
        local function hide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 1
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = false
                end
            end
        end

        local function unhide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 0
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = true
                end
            end
        end

        if state then
            local playerConns = {}

            local function watch(plr)
                if plr == LocalPlayer then return end
                if playerConns[plr] then playerConns[plr]:Disconnect() end
                hide(plr)
                playerConns[plr] = plr.CharacterAdded:Connect(function() hide(plr) end)
            end

            for _, plr in ipairs(Players:GetPlayers()) do watch(plr) end

            local addConn = Players.PlayerAdded:Connect(watch)
            local removeConn = Players.PlayerRemoving:Connect(function(plr)
                if playerConns[plr] then
                    playerConns[plr]:Disconnect()
                    playerConns[plr] = nil
                end
            end)

            MystrixHub.HidePlayersStuff = { addConn, removeConn, playerConns, unhide }
        else
            if MystrixHub.HidePlayersStuff then
                local stuff = MystrixHub.HidePlayersStuff
                pcall(function() stuff[1]:Disconnect() end)
                pcall(function() stuff[2]:Disconnect() end)
                for _, c in pairs(stuff[3]) do pcall(function() c:Disconnect() end) end
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then pcall(function() stuff[4](plr) end) end
                end
                MystrixHub.HidePlayersStuff = nil
            end
        end
    end,
})

