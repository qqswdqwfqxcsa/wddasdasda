function MystrixHub.Functions.GetEggMutations(eggModel)
    if not eggModel then return {} end
    local result = {}

    local ok, pos = pcall(function() return eggModel:GetPivot().Position end)
    if not ok or not pos then return result end

    local RS = game:GetService("ReplicatedStorage")
    local sd = RS:FindFirstChild("ServerData")
    local activeEggs = sd and sd:FindFirstChild("ActiveEggs")
    if not activeEggs then return result end

    local eggName = eggModel.Name

    for _, entry in ipairs(activeEggs:GetChildren()) do
        local entryEgg = entry:GetAttribute("Egg")
        if entryEgg == eggName then
            local entryPos = entry:GetAttribute("Position")
            local match = false

            if typeof(entryPos) == "Vector3" then
                match = (entryPos - pos).Magnitude < 10
            elseif typeof(entryPos) == "CFrame" then
                match = (entryPos.Position - pos).Magnitude < 10
            end

            if match then
                local mut = entry:GetAttribute("Mutation")
                if type(mut) == "string" then
                    mut = mut:match("^%s*(.-)%s*$")
                    if mut ~= "" and mut ~= "None" then
                        table.insert(result, mut)
                    end
                end
                return result
            end
        end
    end

    return result
end

function MystrixHub.Functions.EggPassesMutationFilter(eggModel, selectedMutations)
    if type(selectedMutations) ~= "table" then return true end
    if #selectedMutations == 0 then return true end
    if table.find(selectedMutations, "Any") then return true end

    local eggMuts = MystrixHub.Functions.GetEggMutations(eggModel)
    local wantNone = table.find(selectedMutations, "None") ~= nil

    if #eggMuts == 0 then
        return wantNone
    end

    for _, m in ipairs(eggMuts) do
        if table.find(selectedMutations, m) then return true end
    end

    return false
end

