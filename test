function MystrixHub.StageFarmController.WaitForEnemies(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 15) do
        local folder = workspace:FindFirstChild("EnemyFolder")
        if folder then
            local count = 0
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Model") and not child:GetAttribute("Dead") then
                    count = count + 1
                end
            end
            if count > 0 then return true end
        end
        task.wait(0.2)
    end
    return false
end

function MystrixHub.StageFarmController.WaitForAllEnemiesDead(timeout)
    local C = MystrixHub.StageFarmController
    local t0 = tick()
    while tick() - t0 < (timeout or 90) do
        if not C.Running then return false end
        local folder = workspace:FindFirstChild("EnemyFolder")
        local alive = 0
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Model") and not child:GetAttribute("Dead") then
                    alive = alive + 1
                end
            end
        end
        if alive == 0 then return true end
        task.wait(0.3)
    end
    return false
end

function MystrixHub.StageFarmController.WaitForOres(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 15) do
        local cache = workspace:FindFirstChild("OreCache")
        if cache and #cache:GetChildren() > 0 then
            return true
        end
        task.wait(0.2)
    end
    return false
end

function MystrixHub.StageFarmController.GetRemainingOreModels()
    local C = MystrixHub.StageFarmController
    local remaining = {}
    local cache = workspace:FindFirstChild("OreCache")
    if not cache then return remaining end
    for _, model in ipairs(cache:GetChildren()) do
        if model:IsA("Model") and C.ShouldCollectOre(model.Name) then
            local pp = model.PrimaryPart and model.PrimaryPart:FindFirstChildOfClass("ProximityPrompt")
            if pp and pp.Enabled then
                table.insert(remaining, model)
            end
        end
    end
    return remaining
end

function MystrixHub.StageFarmController.CollectOnePass()
    local C = MystrixHub.StageFarmController
    local cache = workspace:FindFirstChild("OreCache")
    if not cache then return 0, 0 end
    local fired   = 0
    local success = 0

    for _, ore in ipairs(cache:GetChildren()) do
        if not C.Running then break end

        if ore:IsA("Model") and ore.PrimaryPart then
            if C.ShouldCollectOre(ore.Name) then
                local pp = ore.PrimaryPart:FindFirstChildOfClass("ProximityPrompt")
                if pp and pp.Enabled and fireproximityprompt then
                    fired = fired + 1
                    pcall(fireproximityprompt, pp)
                    task.wait(0.08)
                    if not pp.Enabled or not ore.Parent then
                        success = success + 1
                        C._collected = C._collected + 1
                    end
                end
            end
        end
    end
    return fired, success
end

function MystrixHub.StageFarmController.GetSpawnPart()
    local candidates = {
        workspace:FindFirstChild("SpawnLocation"),
        workspace:FindFirstChild("Spawn"),
        workspace.WorldModel and workspace.WorldModel:FindFirstChild("Spawn"),
        workspace.WorldModel and workspace.WorldModel:FindFirstChild("SpawnLocation"),
        workspace.WorldModel and workspace.WorldModel:FindFirstChild("StageMap") and workspace.WorldModel.StageMap:FindFirstChild("Spawn"),
        workspace.WorldModel and workspace.WorldModel:FindFirstChild("StageMap") and workspace.WorldModel.StageMap:FindFirstChild("SpawnLocation"),
    }
    for _, p in ipairs(candidates) do
        if p and p:IsA("BasePart") then return p end
    end
    return nil
