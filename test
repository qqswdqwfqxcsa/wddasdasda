function MystrixHub.Functions.GetAllEggNames()
    local eggs = MystrixHub.Functions.GetGameEggs()
    local names = {}
    for name, data in pairs(eggs) do
        if type(data) == "table" and data.Rarity then
            table.insert(names, name)
        end
    end

    table.sort(names, function(a, b)
        local ta, la = MystrixHub.Functions.GetEggSortScore(a)
        local tb, lb = MystrixHub.Functions.GetEggSortScore(b)
        if ta ~= tb then return ta > tb end
        if la ~= lb then return la > lb end
        return a < b
    end)
    return names
end

function MystrixHub.Functions.GetEggRarityByName(name)
    if type(name) ~= "string" then return "Common" end

    local C = MystrixHub.GameDataCache
    if not C.Eggs then MystrixHub.Functions.RefreshGameData() end
    if C.Eggs and C.Eggs[name] then
        local r = C.Eggs[name].Rarity
        if type(r) == "string" then return r end
        if type(r) == "table" then return r.DisplayName or r._id or r.Name or "Common" end
    end

    local fb = MystrixHub.FallbackEggs[name]
    if fb and type(fb.Rarity) == "string" then return fb.Rarity end

    local AssetsDir = MystrixHub.Functions.LoadAssetsDirectory()
    if AssetsDir and AssetsDir[name] then
        local r = AssetsDir[name].Rarity
        if type(r) == "table" then
            return r.DisplayName or r._id or r.Name or "Common"
        elseif type(r) == "string" then
            return r
        end
    end

    local nm = name:lower()
    if     nm:find("cherub") or nm:find("blackhole") or nm:find("giant") or nm:find("dragon") or nm:find("solaris") then return "Ethereal"
    elseif nm:find("aurora") or nm:find("galaxy") then return "Divine"
    elseif nm:find("skull") or nm:find("asteroid") or nm:find("dominus")
        or nm:find("flaming") or nm:find("sinister") or nm:find("soul")
        or nm:find("crystal") or nm:find("diamond") then return "Mythic"
    elseif nm:find("glass") or nm:find("golden") then return "Legendary"
    elseif nm:find("mushroom") or nm:find("flower") or nm:find("slime") or nm:find("ice") then return "Epic"
    elseif nm:find("cracked") or nm:find("easter") or nm:find("stone") or nm:find("leaf") then return "Rare"
    else return "Common" end
end

