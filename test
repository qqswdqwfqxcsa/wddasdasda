function MystrixHub.FrostTowerController.StartTicketWatcher(paragraph)
    local C = MystrixHub.FrostTowerController
    C._ticketParagraph = paragraph
    if C._ticketLoop then return end
    C._ticketLoop = task.spawn(function()
        while true do
            local count = C.GetTicketCount()
            C._currentTickets = count
            local text
            if count == nil then
                text = "Tower Tickets: --"
            elseif count <= 0 then
                text = "Tower Tickets: 0 (out of tickets — auto farm disabled)"
            else
                text = "Tower Tickets: " .. tostring(count)
            end
            pcall(function()
                if C._ticketParagraph then
                    C._ticketParagraph:SetDesc(text)
                end
            end)
            task.wait(0.5)
        end
    end)
