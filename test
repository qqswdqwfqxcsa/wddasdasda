        or tool:GetAttribute("MutationType")
        or tool:GetAttribute("Mut")
        or "None"
    if mutation == "" then mutation = "None" end

    for _, m in ipairs(mutFilter) do
        if type(m) == "string" and m:lower() == mutation:lower() then
            return true
        end
    end
    return false
end

