    if MystrixHub.UIController.VersionTag then MystrixHub.UIController.VersionTag:SetColor(accent) end
    if MystrixHub.UIController.FPSTag     then MystrixHub.UIController.FPSTag:SetColor(accent)     end
    if MystrixHub.UIController.PingTag    then MystrixHub.UIController.PingTag:SetColor(accent)    end
end

function MystrixHub.ConfigController.GetAllConfigNames()
    local configs = {}
    local ok, result = pcall(function() return MystrixHub.UIController.Window.ConfigManager:AllConfigs() end)
    if ok and result then
        for _, configName in ipairs(result) do table.insert(configs, configName) end
    end
    if #configs == 0 then table.insert(configs, "No configs found") end
    return configs
end

function MystrixHub.ConfigController.SaveLastConfigName(name)
    pcall(function() if writefile then writefile(MystrixHub.ConfigController.LastConfigFile, name) end end)
end

function MystrixHub.ConfigController.LoadLastConfigName()
    local ok, result = pcall(function()
        if readfile and isfile and isfile(MystrixHub.ConfigController.LastConfigFile) then
            return readfile(MystrixHub.ConfigController.LastConfigFile)
        end
        return nil
    end)
    if ok and result and result ~= "" then return result end
    return nil
end

function MystrixHub.ConfigController.GetAutoLoadSetting()
    local ok, result = pcall(function()
        if readfile and isfile and isfile(MystrixHub.ConfigController.AutoLoadFile) then
            return readfile(MystrixHub.ConfigController.AutoLoadFile) == "true"
        end
        return false
    end)
    return ok and result or false
end

function MystrixHub.ConfigController.SetAutoLoadSetting(value)
    pcall(function() if writefile then writefile(MystrixHub.ConfigController.AutoLoadFile, value and "true" or "false") end end)
end

function MystrixHub.ConfigController.GetConfig(configName)
    if MystrixHub.ConfigController.Cache[configName] then return MystrixHub.ConfigController.Cache[configName] end
    local config = MystrixHub.UIController.Window.ConfigManager:CreateConfig(configName)
    MystrixHub.ConfigController.Cache[configName] = config
    return config
end

function MystrixHub.Functions.AttemptAutoLoad()
    if MystrixHub.ConfigController.GetAutoLoadSetting() then
        local lastConfig = MystrixHub.ConfigController.LoadLastConfigName()
        if lastConfig and lastConfig ~= "" then
            task.spawn(function()
                task.wait(0.5)
                local configToLoad = MystrixHub.ConfigController.GetConfig(lastConfig)
                local ok, err = pcall(function() configToLoad:Load() end)
                if ok then
                    task.wait(0.1)
                    MystrixHub.Functions.SyncDropdownsToState()
                    WindUI:Notify({ Title = "Auto Load", Content = "Loaded last config: " .. lastConfig, Duration = 3, Icon = "check-circle" })
                else
                    WindUI:Notify({ Title = "Auto Load Failed", Content = tostring(err), Duration = 3, Icon = "alert-circle" })
                end
            end)
        end
    end
end

