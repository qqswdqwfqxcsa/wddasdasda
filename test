function MystrixHub.Functions.StartForgeSkip()
    local C = MystrixHub.ForgeSkipController
    if C._hooked then
        C.Enabled = true
        return
    end
    local ok, Moon2 = pcall(function() return require(game:GetService("ReplicatedStorage").Tool.Moon2Cutscene) end)
    if not ok or type(Moon2) ~= "table" then
        WindUI:Notify({ Title = "Skip Forge", Content = "Failed to load Moon2Cutscene module.", Duration = 4, Icon = "alert-circle" })
        return
    end
    if type(Moon2.play) == "function" then
        C._orig.play = Moon2.play
        Moon2.play = function(self, ...)
            if C.Enabled then
                pcall(function()
                    self.timeElapsed = 850
                    if type(self.setFrame) == "function" then
                        self:setFrame(850)
                    end
                    self.isPlaying = false
                end)
                return
            end
            return C._orig.play(self, ...)
        end
    end
    if type(Moon2.wait) == "function" then
        C._orig.wait = Moon2.wait
        Moon2.wait = function(self, ...)
            if C.Enabled then return end
            return C._orig.wait(self, ...)
        end
    end
    C._hooked = true
    C.Enabled = true
end

