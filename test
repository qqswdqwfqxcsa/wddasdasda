function MystrixHub.Functions.AttemptAutoLoad()
    if MystrixHub.ConfigController.GetAutoLoadSetting() then
        local lastConfig = MystrixHub.ConfigController.LoadLastConfigName()
        if lastConfig and lastConfig ~= "" then
            task.spawn(function()
                task.wait(0.5)
                local configToLoad = MystrixHub.ConfigController.GetConfig(lastConfig)
                local ok, err = pcall(function() configToLoad:Load() end)
                if ok then
                    task.wait(0.1)
                    MystrixHub.Functions.SyncDropdownsToState()
                    WindUI:Notify({ Title = "Auto Load", Content = "Loaded last config: " .. lastConfig, Duration = 3, Icon = "check-circle" })
                else
                    WindUI:Notify({ Title = "Auto Load Failed", Content = tostring(err), Duration = 3, Icon = "alert-circle" })
                end
            end)
        end
    end
end

