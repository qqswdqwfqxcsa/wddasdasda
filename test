MystrixHub.Functions.FetchKeyFromDisk = function()
    local savedKey = nil
    pcall(function()
        local folders = {
            "WindUI/" .. GAME_FOLDER_NAME,
            GAME_FOLDER_PATH,
            "WindUI",
        }
        for _, folder in ipairs(folders) do
            local ok, files = pcall(listfiles, folder)
            if ok and files then
                for _, f in ipairs(files) do
                    if tostring(f):match("%.key$") then
                        local rok, content = pcall(readfile, f)
                        if rok and content and content ~= "" then
                            savedKey = content:match("^%s*(.-)%s*$")
                            if savedKey and savedKey ~= "" then return end
                        end
                    end
                end
            end
        end
    end)
    return (savedKey and savedKey ~= "") and savedKey or nil
end

MystrixHub.Functions.FetchKeyFromAPI = function()
    local savedKey = nil
    if MystrixHub.Auth.RawKey and MystrixHub.Auth.RawKey ~= "" then
        savedKey = MystrixHub.Auth.RawKey
    else
        savedKey = MystrixHub.Functions.FetchKeyFromDisk()
    end
    if not savedKey or savedKey == "" then
        return nil, "NO_KEY_FOUND"
    end
    local success, result = MystrixHub.Functions.VerifyKey(savedKey)
    if success and type(result) == "table" then
        return result, nil
    else
        return nil, tostring(result)
    end
end

MystrixHub.Functions.IsKeyExpired = function(result, errCode)
    if errCode == "EXPIRED"   then return true end
    if errCode == "REVOKED"   then return true end
    if errCode == "NOT_FOUND" then return true end
    if result and result.validUntil then
        local ok, dt = pcall(function() return DateTime.fromIsoDate(result.validUntil) end)
        if ok and dt then return dt.UnixTimestamp < os.time() end
    end
    if result and result.expiresIn then
        return result.expiresIn <= 0
    end
    return false
end

MystrixHub.Functions.UpdateKeyInfoFromResult = function(result)
    if not result then return end
    if result.validUntil then
        local ok, dt = pcall(function() return DateTime.fromIsoDate(result.validUntil) end)
        if ok and dt then
            local sLeft = dt.UnixTimestamp - os.time()
            MystrixHub.KeyDisplay.TimeLeftText = sLeft > 0 and MystrixHub.Functions.FormatTimeRemaining(sLeft) or "Expired"
            local dateStr = MystrixHub.Functions.FormatExpiry(result.validUntil)
            if dateStr then MystrixHub.KeyDisplay.ExpiryText = dateStr end
        end
    elseif result.expiresIn then
        MystrixHub.KeyDisplay.TimeLeftText = result.expiresIn > 0 and MystrixHub.Functions.FormatTimeRemaining(result.expiresIn) or "Expired"
    end
    pcall(function()
        if KeyInfoParagraph then
            KeyInfoParagraph:SetDesc(
                "Key Label: "    .. MystrixHub.KeyDisplay.KeyLabelText ..
                "\nKey ID: "     .. MystrixHub.KeyDisplay.KeyIdText ..
                "\nTime Left: "  .. MystrixHub.KeyDisplay.TimeLeftText ..
                "\nExecutions: " .. MystrixHub.KeyDisplay.ExecCountStr
            )
        end
    end)
end

MystrixHub.Functions.StartKeyValidation = function()
    if MystrixHub.KeyValidation.Running then return end
    MystrixHub.KeyValidation.Running = true
    MystrixHub.KeyValidation.Loop = task.spawn(function()
        task.wait(10)
        while MystrixHub.KeyValidation.Running do
            local result, errCode = MystrixHub.Functions.FetchKeyFromAPI()

            if errCode == "NETWORK_ERROR" then
                task.wait(10)
                continue
            end

            if result then
                MystrixHub.KeyValidation.ConfirmCount = 0
                MystrixHub.Functions.UpdateKeyInfoFromResult(result)
            end

            local expired = MystrixHub.Functions.IsKeyExpired(result, errCode)

            if expired then
                for i = 1, 5 do
                    WindUI:Notify({
                        Title    = "Key Validation",
                        Content  = string.format("Your key has Expired! (%d out of 5)", i),
                        Duration = 9,
                        Icon     = "triangle-alert",
                    })
                    task.wait(10)

                    local resCheck, errCheck = MystrixHub.Functions.FetchKeyFromAPI()
                    if errCheck ~= "NETWORK_ERROR" and resCheck then MystrixHub.Functions.UpdateKeyInfoFromResult(resCheck) end
                    if not MystrixHub.Functions.IsKeyExpired(resCheck, errCheck) then
                        MystrixHub.KeyValidation.ConfirmCount = 0
                        break
                    end

                    if i == 5 then
                        local kickReason = "Key Expired!"
                        if errCheck == "REVOKED"      then kickReason = "Key Revoked!" end
                        if errCheck == "NOT_FOUND"    then kickReason = "Key Deleted from Server!" end
                        if errCheck == "NO_KEY_FOUND" then kickReason = "No Key Found!" end

                        WindUI:Notify({
                            Title    = "Key Validation",
                            Content  = "All 5 checks failed. Reason: " .. kickReason .. " You will be kicked in a minute!",
                            Duration = 60,
                            Icon     = "x-circle",
                        })

                        task.wait(60)
                        MystrixHub.KeyValidation.Running = false
                        LocalPlayer:Kick(kickReason)
                        return
                    end
                end
            else
                MystrixHub.KeyValidation.ConfirmCount = 0
            end

            task.wait(10)
        end
    end)
end

