function MystrixHub.Functions.FireHatchPrompts()
    local eggsFolder = MystrixHub.Functions.GetPlotEggsFolder()
    if not eggsFolder then return 0 end

    local RS = game:GetService("ReplicatedStorage")
    local remotes = RS:FindFirstChild("Remotes")
    local gameFolder = remotes and remotes:FindFirstChild("Game")
    local hatchRemote = gameFolder and gameFolder:FindFirstChild("Hatch")
    if not hatchRemote then return 0 end

    local M = MystrixHub.MainController
    local filter = M.AutoHatchSelectedEggs or {}
    local isAll = #filter == 0 or table.find(filter, "All") ~= nil

    local allowed = {}
    if not isAll then
        for _, n in ipairs(filter) do
            if type(n) == "string" and n ~= "" then
                allowed[n:lower()] = true
            end
        end
    end

    local fired = 0
    for _, eggModel in ipairs(eggsFolder:GetChildren()) do
        if eggModel:IsA("Model") then
            local eggKey = eggModel:GetAttribute("EggKey")
            if eggKey then
                local eggName = eggModel:GetAttribute("Egg") or eggModel.Name
                if type(eggName) == "string" then
                    eggName = eggName:match("^([^%[]+)") or eggName
                    eggName = eggName:match("^%s*(.-)%s*$") or eggName
                end

                local pass = isAll or (allowed[eggName:lower()] == true)
                if pass then
                    pass = MystrixHub.Functions.EggPassesWeightFilter(eggModel)
                end
                if pass then
                    pcall(function()
                        hatchRemote:FireServer({ EggKey = eggKey })
                    end)
                    fired = fired + 1
                end
            end
        end
    end
    return fired
end

