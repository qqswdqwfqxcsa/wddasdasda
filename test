function MystrixHub.StageFarmController.GetAllStageNames()
    local names = {}
    local ok, cfg = pcall(function()
        return require(game:GetService("ReplicatedStorage").Config.Stage.Helper).GetStageEnemyConfig()
    end)
    if ok and type(cfg) == "table" then
        local keys = {}
        for k in pairs(cfg) do table.insert(keys, k) end
        table.sort(keys, function(a, b)
            return (tonumber(a:match("%d+")) or 0) < (tonumber(b:match("%d+")) or 0)
        end)
        return keys
    end
    for i = 1, 30 do table.insert(names, "Stage_" .. i) end
    return names
end

