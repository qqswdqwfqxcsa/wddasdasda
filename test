end

function MystrixHub.Functions.EggESP_AddEgg(eggModel)
    if not eggModel or not eggModel.Parent then return end
    local S = MystrixHub.EggESPController

    local existing = S.Entries[eggModel]
    if existing then
        if existing.adornee and existing.adornee.Parent
           and existing.hl and existing.hl.Parent then
            return
        end
        if existing.hl        then existing.hl:Destroy()        end
        if existing.billboard then existing.billboard:Destroy() end
        if existing.adornee   then existing.adornee:Destroy()   end
        S.Entries[eggModel] = nil
    end

    local ok, cf, size = pcall(function()
        local c, s = eggModel:GetBoundingBox()
        return c, s
    end)
    if not ok or not cf or not size then return end
    local baseSize = size

    local attachTo = eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA("BasePart")
    if not attachTo then return end

    local rarity = MystrixHub.Functions.GetEggRarityByName(eggModel.Name)
    local color  = MystrixHub.EggRarityColors[rarity] or MystrixHub.EggRarityColors.Common

    local adornee = Instance.new("Part")
    adornee.Name         = "MystrixEggESP_Adornee"
    adornee.Size         = baseSize * S.SizeMultiplier
    adornee.CFrame       = cf
    adornee.Anchored     = true
    adornee.CanCollide   = false
    adornee.CanQuery     = false
    adornee.CanTouch     = false
    adornee.Massless     = true
    adornee.Transparency = 1
    adornee.Parent       = eggModel

    local weld = Instance.new("WeldConstraint")
    weld.Part0  = adornee
    weld.Part1  = attachTo
    weld.Parent = adornee

    local hl = Instance.new("Highlight")
    hl.Name                = "MystrixEggESP_HL"
    hl.Adornee             = adornee
    hl.FillColor           = color
    hl.FillTransparency    = 0.6
    hl.OutlineColor        = color
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = MystrixHub.Functions.EggESP_GetScreenGui()

    local bb = Instance.new("BillboardGui")
    bb.Name           = "MystrixEggESP_Label"
    bb.Adornee        = adornee
    bb.AlwaysOnTop    = true
    bb.LightInfluence = 0
    bb.Size           = UDim2.fromOffset(280, 24)
    bb.StudsOffset    = Vector3.new(0, 0, 0)
    bb.Parent         = MystrixHub.Functions.EggESP_GetScreenGui()

    local text = Instance.new("TextLabel")
    text.Name                   = "Name"
    text.BackgroundTransparency = 1
    text.Size                   = UDim2.fromScale(1, 1)
    text.Font                   = Enum.Font.GothamBold
    text.TextScaled             = false
    text.TextSize               = 18
    text.TextColor3             = color
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3       = Color3.new(0, 0, 0)
    local nameText = eggModel.Name
    if S.WeightESPEnabled then
        local weightStr = MystrixHub.Functions.GetEggWeightDisplay(eggModel)
        if weightStr then
            nameText = nameText .. " [" .. weightStr .. " kg]"
        end
    end
    if S.MutationESPEnabled then
        local mutStr = MystrixHub.Functions.GetEggMutationDisplay(eggModel)
        if mutStr then
            nameText = nameText .. " {" .. mutStr .. "}"
        end
    end
    text.Text   = nameText
    text.Parent = bb

    S.Entries[eggModel] = {
        hl        = hl,
        billboard = bb,
        text      = text,
        adornee   = adornee,
        baseSize  = baseSize,
        color     = color,
    }
end

function MystrixHub.Functions.EggESP_Refresh()
    local S = MystrixHub.EggESPController
    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return end

    for _, eggModel in ipairs(renderedEggs:GetChildren()) do
        if eggModel:IsA("Model") and MystrixHub.Functions.EggESP_ShouldShow(eggModel.Name) then
            MystrixHub.Functions.EggESP_AddEgg(eggModel)
        end
    end

    for eggModel, entry in pairs(S.Entries) do
        if not eggModel or not eggModel.Parent
           or not MystrixHub.Functions.EggESP_ShouldShow(eggModel.Name) then
            if entry.hl        then entry.hl:Destroy()        end
            if entry.billboard then entry.billboard:Destroy() end
            if entry.adornee   then entry.adornee:Destroy()   end
            S.Entries[eggModel] = nil
        end
    end
end

function MystrixHub.Functions.EggESP_ApplyMultiplier(mult)
    local S = MystrixHub.EggESPController
    mult = math.clamp(tonumber(mult) or 1, 1, 10)
    S.SizeMultiplier = mult

    for _, entry in pairs(S.Entries) do
        if entry.adornee and entry.adornee.Parent and entry.baseSize then
            entry.adornee.Size = entry.baseSize * mult

            if entry.billboard and entry.billboard.Parent then
                entry.billboard.StudsOffset =
                    Vector3.new(0, (entry.baseSize.Y * mult) / 2 + 2, 0)
            end
        end
    end
end

function MystrixHub.Functions.EggESP_StartLoops()
