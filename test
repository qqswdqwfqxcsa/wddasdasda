function MystrixHub.Functions.GetEggServerEntry(eggModel)
    if not eggModel then return nil end

    local ok, pos = pcall(function() return eggModel:GetPivot().Position end)
    if not ok or not pos then return nil end

    local RS = game:GetService("ReplicatedStorage")
    local sd = RS:FindFirstChild("ServerData")
    local activeEggs = sd and sd:FindFirstChild("ActiveEggs")
    if not activeEggs then return nil end

    local eggName = eggModel.Name

    for _, entry in ipairs(activeEggs:GetChildren()) do
        if entry:GetAttribute("Egg") == eggName then
            local entryPos = entry:GetAttribute("Position")
            local match = false

            if typeof(entryPos) == "Vector3" then
                match = (entryPos - pos).Magnitude < 30
            elseif typeof(entryPos) == "CFrame" then
                match = (entryPos.Position - pos).Magnitude < 30
            end

            if match then return entry end
        end
    end

    return nil
end

function MystrixHub.Functions.IsTargetEggAlreadyDipped(eggModel)
    if not eggModel then return false end

    local ok, pos = pcall(function() return eggModel:GetPivot().Position end)
    if not ok or not pos then return false end

    local RS = game:GetService("ReplicatedStorage")
    local sd = RS:FindFirstChild("ServerData")
    local ae = sd and sd:FindFirstChild("ActiveEggs")
    if not ae then return false end

    local eggName = eggModel.Name
    for _, entry in ipairs(ae:GetChildren()) do
