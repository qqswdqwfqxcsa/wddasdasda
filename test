    local LocalPlayer = game.Players.LocalPlayer
    local StageUtils = C.GetStageUtils()

    if StageUtils then
        pcall(function() StageUtils.ExitFight(false, true) end)
        task.wait(0.4)
    end

    pcall(function() LocalPlayer:SetAttribute("StageID", nil) end)
    task.wait(0.15)
    pcall(function() LocalPlayer:SetAttribute("StageID", stageName) end)
    task.wait(0.5)
end

function MystrixHub.StageFarmController.ClearEnemiesOnce()
    local C = MystrixHub.StageFarmController
    if not C.WaitForEnemies(20) then return end
    C.StartTeleportLoop()
    C.StartAttackLoop()
    C.WaitForAllEnemiesDead(120)
    C.StopTeleportLoop()
    C.StopAttackLoop()
end

function MystrixHub.StageFarmController.RunIteration()
    local C = MystrixHub.StageFarmController

    local stages = {}
    if C.AllMode then
        stages = C.GetAllStageNames()
    else
        for _, s in ipairs(C.WantedStages) do
            table.insert(stages, s)
        end
        if #stages == 0 then
            stages = C.GetAllStageNames()
        end
    end

    local singleStage = (not C.AllMode and #C.WantedStages == 1)

    if singleStage then
        local stageName = C.WantedStages[1]
        while C.Running do
            if C._collected >= C._capacity then
                C.DepositAndReturn()
                if not C.Running then return end
                C._collected = 0
            end

            C.EnterStageFresh(stageName)
            C.ClearEnemiesOnce()
            if not C.Running then return end

            C.WaitForOres(15)
            task.wait(0.6)
            C.CollectAndDepositLoop()
            task.wait(0.4)
        end
        return
    end

    for _, stageName in ipairs(stages) do
        if not C.Running then return end

        if C._collected >= C._capacity then
            C.DepositAndReturn()
            if not C.Running then return end
            C._collected = 0
        end

        C.EnterStageFresh(stageName)
        C.ClearEnemiesOnce()
        if not C.Running then return end

        C.WaitForOres(15)
        task.wait(0.6)
        C.CollectAndDepositLoop()
        task.wait(0.4)
    end
end

function MystrixHub.Functions.StartStageFarm()
    local C = MystrixHub.StageFarmController
    if C.Running then return end

    C._capacity = C.ReadCapacity()
    C._collected = 0
    C._savedCF = nil

    C.Enabled = true
    C.Running = true
    C.ForceIKGMOn()

    C.Loop = task.spawn(function()
        while C.Running do
            local ok, err = pcall(C.RunIteration)
            if not ok then
                warn("[StageFarm] " .. tostring(err))
                task.wait(2)
            end
            task.wait(0.5)
        end
        C.Running = false
    end)
    MystrixHub.TasksController.Insert(C.Loop)
end

function MystrixHub.Functions.StopStageFarm()
    local C = MystrixHub.StageFarmController
    C.Enabled = false
    C.Running = false
    if C.Loop then
        task.cancel(C.Loop)
        C.Loop = nil
    end
    C.StopTeleportLoop()
    C.StopAttackLoop()
    C.RestoreIKGM()

    local LocalPlayer = game.Players.LocalPlayer
    local StageUtils = C.GetStageUtils()

    if StageUtils then
        pcall(function() StageUtils.ExitFight(false, true) end)
        task.wait(0.3)
    end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local teleported = false

    local TranslateUtils = C.GetTranslateUtils()
    if TranslateUtils and type(TranslateUtils.ToSpawn) == "function" then
        local ok = pcall(function() TranslateUtils.ToSpawn(char) end)
        if ok then teleported = true end
    end

    if not teleported then
        local spawn = C.GetSpawnPart()
        if spawn then
            pcall(function()
                hrp.CFrame = spawn.CFrame + Vector3.new(0, 5, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        else
            pcall(function()
                hrp.CFrame = CFrame.new(0, 1000, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    C._savedCF = nil
    C._collected = 0
end

