function MystrixHub.Functions.GetCollectedEggsSet()
    local set = {}
    local raw = LocalPlayer:GetAttribute("CollectedEggs")
    if type(raw) == "string" and raw ~= "" then
        for name in raw:gmatch("[^,]+") do
            set[name] = true
        end
    end
    return set
end

function MystrixHub.Functions.FindBestIndexTarget()
    local renderedEggs = Workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return nil end

    local collected = MystrixHub.Functions.GetCollectedEggsSet()
    local plot    = MystrixHub.AutoFarmController.CachedPlot
    local plotPos = plot and plot:GetPivot().Position

    local candidates = {}
    for _, eggModel in ipairs(renderedEggs:GetChildren()) do
        if eggModel:IsA("Model") then
            local name       = eggModel.Name
            local rarity     = MystrixHub.Functions.GetEggRarityByName(name)
            local isEthereal = (rarity == "Ethereal")
            local isCollected = collected[name] == true

            if isEthereal or not isCollected then
                local tier = MystrixHub.EggRarityTier[rarity] or 0
                table.insert(candidates, {
                    model      = eggModel,
                    name       = name,
                    rarity     = rarity,
                    tier       = tier,
                    isEthereal = isEthereal,
                })
            end
        end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.isEthereal ~= b.isEthereal then return a.isEthereal end
        if a.tier ~= b.tier then return a.tier > b.tier end
        if plotPos then
            local da = (a.model:GetPivot().Position - plotPos).Magnitude
            local db = (b.model:GetPivot().Position - plotPos).Magnitude
            if da ~= db then return da < db end
        end
        return a.name < b.name
    end)

    return candidates[1]
end

