function MystrixHub.Functions.StartUpgradeFarm()
    local C = MystrixHub.UpgradeController
    if C.Running then return end
    C.Running = true
    C.Loop = task.spawn(function()
        while C.IsSectionEnabled() do
            pcall(C.Tick)
            task.wait(C.Interval)
        end
        C.Running = false
    end)
    MystrixHub.TasksController.Insert(C.Loop)
end

function MystrixHub.Functions.StopUpgradeFarm()
    local C = MystrixHub.UpgradeController
    C.Running = false
    if C.Loop then
        task.cancel(C.Loop)
        C.Loop = nil
    end
end

function MystrixHub.Functions.SetUpgradeFlag(sectionName, enabled)
    local C = MystrixHub.UpgradeController
    C.Flags[sectionName] = enabled and true or false
    if C.IsSectionEnabled() then
        if not C.Running then
