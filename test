function MystrixHub.StageFarmController.DepositAndReturn()
    local C = MystrixHub.StageFarmController
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    C._savedCF = hrp.CFrame

    local teleported = false

    local TranslateUtils = C.GetTranslateUtils()
    if TranslateUtils and type(TranslateUtils.ToSpawn) == "function" then
        local ok = pcall(function() TranslateUtils.ToSpawn(char) end)
        if ok then teleported = true end
    end

    if not teleported then
        local spawn = C.GetSpawnPart()
        if spawn then
            pcall(function()
                hrp.CFrame = spawn.CFrame + Vector3.new(0, 5, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            teleported = true
        end
    end

    task.wait(1.2)

    local CommUtils = C.GetCommUtils()
    if CommUtils then
        local claimRE = CommUtils.TryGetRemoteEvent("Stage", "ClaimedAllOreRE")
        if claimRE then
            pcall(function() claimRE:FireServer() end)
        end
    end

    task.wait(3)

    if C._savedCF then
        pcall(function()
            hrp.CFrame = C._savedCF
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        C._savedCF = nil
    end

    task.wait(0.6)
end

function MystrixHub.StageFarmController.CollectAndDepositLoop()
    local C = MystrixHub.StageFarmController

    while C.Running do
        if C._collected >= C._capacity then
            C.DepositAndReturn()
            if not C.Running then return end
            C._collected = 0
        end

        local remaining = C.GetRemainingOreModels()
        if #remaining == 0 then return end

        local fired, success = C.CollectOnePass()
        task.wait(0.3)

        local stillRemaining = C.GetRemainingOreModels()
        if #stillRemaining == 0 then return end

        if fired > 0 and success == 0 then
            C.DepositAndReturn()
            if not C.Running then return end
            C._collected = 0
        elseif C._collected >= C._capacity then
            C.DepositAndReturn()
            if not C.Running then return end
            C._collected = 0
        else
            task.wait(0.4)
        end
    end
end

function MystrixHub.StageFarmController.EnterStageFresh(stageName)
