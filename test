function MystrixHub.Functions.EggPassesWeightFilter(eggModel)
    local M = MystrixHub.MainController
    local slider = tonumber(M.AutoHatchWeightSlider) or 0
    if slider <= 0 then return true end

    local shownWeight = MystrixHub.Functions.GetPlotEggShownWeight(eggModel)
    if not shownWeight then
        return false
    end

    local threshold = slider * 1000
    local method = M.AutoHatchMethod or "Below"

    if method == "Below" then
        return shownWeight <= threshold
    else
        return shownWeight >= threshold
    end
end

function MystrixHub.Functions.FormatEggWeightNumber(realWeight)
    realWeight = tonumber(realWeight)
    if not realWeight then return nil end

    local anchors = MystrixHub.EggWeightAnchors
    local shown

    if realWeight <= anchors[1].Real then
        shown = anchors[1].Shown
    else
        shown = anchors[#anchors].Shown
        for i = 1, #anchors - 1 do
            local a = anchors[i]
            local b = anchors[i + 1]
            if realWeight <= b.Real then
                local t = (realWeight - a.Real) / (b.Real - a.Real)
                local lg = math.log10(a.Shown) + (math.log10(b.Shown) - math.log10(a.Shown)) * t
                shown = 10 ^ lg
                break
            end
        end
    end

    return shown
end

function MystrixHub.Functions.GetEggMutationDisplay(eggModel)
    local entry = MystrixHub.Functions.GetEggServerEntry(eggModel)
    if not entry then return nil end

    local mut = entry:GetAttribute("Mutation")
    if type(mut) ~= "string" then return nil end
    mut = mut:match("^%s*(.-)%s*$")
    if mut == "" or mut == "None" then return nil end
    return mut
end

MystrixHub.EggWeightAnchors = {
    { Real = 0.9, Shown = 1 },
    { Real = 1.2, Shown = 15 },
    { Real = 1.5, Shown = 73000 },
    { Real = 2,   Shown = 240000 },
    { Real = 3,   Shown = 1500000 },
}

function MystrixHub.Functions.InflateEggWeight(rawWeight)
    rawWeight = tonumber(rawWeight)
    if not rawWeight then return nil end
    rawWeight = math.max(rawWeight, 0)

    local anchors = MystrixHub.EggWeightAnchors
    if rawWeight <= anchors[1].Real then
        return math.max(anchors[1].Shown, 1)
    end

    for i = 1, #anchors - 1 do
        local a = anchors[i]
        local b = anchors[i + 1]
        if rawWeight <= b.Real then
            if b.Real == a.Real then return a.Shown end
            local t = (rawWeight - a.Real) / (b.Real - a.Real)
            local lg = math.log10(a.Shown) + (math.log10(b.Shown) - math.log10(a.Shown)) * t
            return 10 ^ lg
        end
    end

    return anchors[#anchors].Shown
end

