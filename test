                if type(v) == "string" and v ~= "" then
                    table.insert(list, v)
                end
            end
        elseif type(value) == "string" and value ~= "" then
            table.insert(list, value)
        end
        return list
    end

    if D.Theme and D.Theme.Value then
        WindUI:SetTheme(D.Theme.Value)
        local accent = MystrixHub.UIController.ThemeAccents[D.Theme.Value] or Color3.fromHex("#FFFFFF")
