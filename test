ConfigSection:Button({
    Title    = "Export Config",
    Icon     = "upload",
    Callback = function()
        task.spawn(function()
            local configName = MystrixHub.ConfigController.SelectedConfig
            if not configName or configName == "" or configName == "No configs found" then
                WindUI:Notify({ Title = "Export Failed", Content = "Please select a config from the dropdown first!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local configPath = MystrixHub.Meta.FolderPath .. "/Config/" .. configName .. ".json"
            local fallbackPath = MystrixHub.Meta.FolderPath .. "/Configs/" .. configName .. ".json"

            local filePath = nil
            if isfile and isfile(configPath) then
                filePath = configPath
            elseif isfile and isfile(fallbackPath) then
                filePath = fallbackPath
            else
                local ok, content = pcall(readfile, configPath)
                if ok and content and content ~= "" then
                    filePath = configPath
                else
                    local ok2, content2 = pcall(readfile, fallbackPath)
                    if ok2 and content2 and content2 ~= "" then
                        filePath = fallbackPath
                    end
                end
            end

            if not filePath then
                WindUI:Notify({ Title = "Export Failed", Content = "Config file not found. Make sure you've saved it at least once.", Duration = 4, Icon = "alert-circle" })
                return
            end

            local raw = nil
            local ok, content = pcall(readfile, filePath)
            if ok and content and content ~= "" then raw = content end

            if not raw then
                WindUI:Notify({ Title = "Export Failed", Content = "Could not read config file content.", Duration = 3, Icon = "alert-circle" })
                return
            end

            local encoded = HttpService:JSONEncode({
                mhub = true,
                v    = MystrixHub.Meta.Version,
                name = configName,
                data = raw,
            })

            if setclipboard then
                setclipboard(encoded)
                WindUI:Notify({
                    Title    = "Config Exported!",
                    Content  = "'" .. configName .. "' copied to clipboard.",
                    Duration = 4,
                    Icon     = "clipboard-check",
                })
            else
                WindUI:Notify({ Title = "No Clipboard", Content = "Your executor does not support setclipboard().", Duration = 3, Icon = "alert-circle" })
            end
        end)
    end,
})

ConfigSection:Input({
    Title       = "Import Config",
    Icon        = "clipboard",
    Placeholder = "Paste exported config string here...",
    Flag        = "ImportConfigInput",
    Callback    = function(value)
        MystrixHub.ConfigController.ImportData = value or ""
    end,
})

ConfigSection:Button({
    Title    = "Import Config",
    Icon     = "download",
    Callback = function()
        task.spawn(function()
            local raw = MystrixHub.ConfigController.ImportData or ""
            if raw == "" then
                WindUI:Notify({ Title = "Import Failed", Content = "Paste a config string into the input above first!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
            if not ok or type(decoded) ~= "table" or not decoded.mhub or not decoded.data or not decoded.name then
                WindUI:Notify({ Title = "Invalid Config", Content = "That doesn't look like a valid Mystrix Hub config!", Duration = 4, Icon = "alert-circle" })
                return
            end

            local configName = tostring(decoded.name)
            pcall(function() makefolder("WindUI") end)
            pcall(function() makefolder(MystrixHub.Meta.FolderPath) end)
            local configDir = MystrixHub.Meta.FolderPath .. "/Config"
            pcall(function() makefolder(configDir) end)

            local writePath = configDir .. "/" .. configName .. ".json"
            local writeOk = pcall(writefile, writePath, decoded.data)

            if not writeOk then
                WindUI:Notify({ Title = "Import Failed", Content = "Could not write config file to disk!", Duration = 3, Icon = "alert-circle" })
                return
            end

            task.wait(0.5)
            MystrixHub.ConfigController.Cache[configName] = nil

            local config = MystrixHub.ConfigController.GetConfig(configName)
            local loadOk, loadErr = pcall(function() config:Load() end)

            if loadOk then
                task.wait(0.1)
                MystrixHub.Functions.SyncDropdownsToState()
                MystrixHub.ConfigController.SaveLastConfigName(configName)
                pcall(function()
                    MystrixHub.ConfigController.Dropdown:Refresh(MystrixHub.ConfigController.GetAllConfigNames())
                    MystrixHub.ConfigController.Dropdown.Value = configName
                    MystrixHub.ConfigController.SelectedConfig = configName
                end)
                WindUI:Notify({
                    Title    = "Config Imported & Loaded!",
                    Content  = "Successfully applied: " .. configName,
                    Duration = 5,
                    Icon     = "check-circle",
                })
            else
                WindUI:Notify({
                    Title    = "Import Failed to Apply",
                    Content  = "File written but could not be loaded.\nError: " .. tostring(loadErr),
                    Duration = 5,
                    Icon     = "alert-circle",
                })
            end
        end)
    end,
})

if MystrixHub.Auth.KeyError == "HWID_RESET" then
    WindUI:Notify({ Title = "HWID Reset Detected", Content = "Your key has been re-linked to this device.", Duration = 6, Icon = "shield-alert" })
elseif MystrixHub.Auth.KeyError then
    WindUI:Notify({ Title = "Key Warning", Content = MystrixHub.Functions.GetFriendlyError(MystrixHub.Auth.KeyError), Duration = 6, Icon = "triangle-alert" })
end

MystrixHub.Functions.AttemptAutoLoad()
