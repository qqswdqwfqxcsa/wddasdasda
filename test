function MystrixHub.Functions.Sell_GetPetRarity(petObj)
    if not petObj then return nil end

    local baseName = petObj.Name:match("^([^%[]+)")
    if baseName then baseName = baseName:match("^%s*(.-)%s*$") end
    if not baseName or baseName == "" then return nil end

    local PetsModule = MystrixHub.Functions.LoadPetsModule()
    if not PetsModule then return nil end

    if PetsModule[baseName] and type(PetsModule[baseName].Rarity) == "string" then
        return PetsModule[baseName].Rarity
    end

    return nil
end

function MystrixHub.Functions.Sell_FindPetsByRarity(selectedRarities)
    local wanted = {}
    for _, r in ipairs(selectedRarities) do wanted[r] = true end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then
        return {}
    end

    local matches = {}
    for _, child in ipairs(backpack:GetChildren()) do
        if child:IsA("Tool") then
            local rarity = MystrixHub.Functions.Sell_GetPetRarity(child)
            if rarity and wanted[rarity] then
                table.insert(matches, child)
            end
        end
    end

    return matches
end

