function MystrixHub.Functions.GetEggScore(eggName)
    local EggsModule = MystrixHub.Functions.GetEggModule()
    if not EggsModule or not EggsModule[eggName] then
        return { tier = 0, luck = 0 }
    end
    local data = EggsModule[eggName]
    local rarity = data.Rarity or "Common"
    local tier = MystrixHub.EggRarityTier[rarity] or 0
    local luck = tonumber(data.Luck) or 0
    return { tier = tier, luck = luck }
end

function MystrixHub.Functions.GetAllMutations()
