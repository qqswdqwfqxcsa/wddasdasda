function MystrixHub.Functions.GetRbxThumbnailUrl(assetUrl)
    if not assetUrl then return nil end
    local id = tostring(assetUrl):match("rbxassetid://(%d+)")
    if not id then return nil end

    local C = MystrixHub.EggPetWebhookController
    if C.ThumbnailCache[id] then return C.ThumbnailCache[id] end

    local fallback = "https://www.roblox.com/asset-thumbnail/image?assetId="
        .. id .. "&width=420&height=420&format=png"

    local ok, resp = pcall(MystrixHub.Functions.MakeRawRequest,
        "https://thumbnails.roblox.com/v1/assets?assetIds=" .. id
        .. "&size=420x420&format=Png&isCircular=false",
        "GET", {["Accept"] = "application/json"}, nil)

    if ok and resp and resp.Body then
        local ok2, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
        if ok2 and data and data.data and data.data[1] and data.data[1].imageUrl then
            C.ThumbnailCache[id] = data.data[1].imageUrl
            return data.data[1].imageUrl
        end
    end

    C.ThumbnailCache[id] = fallback
    return fallback
end

function MystrixHub.Functions.DeliverCarriedEggIfAny()
    if not MystrixHub.Functions.IsCarryingEgg() then return false end

    local A  = MystrixHub.AutoFarmController
    local FS = MystrixHub.FarmSettings

    local plot = A.CachedPlot
    if not plot or not plot.Parent then
        plot = MystrixHub.Functions.GetMyPlot(true)
        if plot then A.CachedPlot = plot end
    end
    if not plot then return true end

    local isFarmRunning = function()
        return A.Running
            or MystrixHub.SpecificEggController.Running
            or MystrixHub.IndexController.Running
            or MystrixHub.RarityFarmController.Running
    end

    if FS.AutoDIP and not MystrixHub.Functions.IsCarriedEggDipped() then
        pcall(MystrixHub.Functions.RunGenericVolcanoDip, isFarmRunning)
    end

    MystrixHub.Functions.ReturnToBase(plot)
    return true
end

