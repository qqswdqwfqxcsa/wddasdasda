function MystrixHub.Functions.ReturnToBase(plot)
    local A  = MystrixHub.AutoFarmController
    local cfg = A.Config

    local basePos = A.BaseplatePos or MystrixHub.Functions.GetBaseplatePosition(plot)
    if not basePos then return false end

    if workspace.StreamingEnabled then
        pcall(function()
            workspace:RequestStreamAroundAsync(basePos + Vector3.new(0, 500, 0))
        end)
        local deadline = tick() + 1.2
        while tick() < deadline do
            local plotPart = plot and plot:FindFirstChild("Baseplate")
            if plotPart and plotPart.Parent then break end
            task.wait(0.1)
        end
    end

    local returnPos = basePos + Vector3.new(0, cfg.TravelHoverHeight, 0)

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local carrying = MystrixHub.Functions.IsCarryingEgg()

    MystrixHub.Functions.KillMountVelocity()
    A.ReturningToBase = true

    if not carrying then
        pcall(function()
            hrp.CFrame = CFrame.new(returnPos)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        local pr = MystrixHub.Functions.GetPetRoot()
        if pr then
            pcall(function()
                pr.CFrame = CFrame.new(returnPos)
                pr.AssemblyLinearVelocity  = Vector3.zero
                pr.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        task.wait(0.4)
        A.ReturningToBase = false
        return true
    end

    local heldEggName = nil
    local heldEggUid  = nil
    local heldItem = MystrixHub.Functions.GetHeldEgg()
    if heldItem and heldItem.instance then
        heldEggName = heldItem.egg
        for _, a in ipairs({"Uid", "UID", "uid", "Id", "ID"}) do
            local v = heldItem.instance:GetAttribute(a)
            if v and tostring(v) ~= "" then
                heldEggUid = tostring(v)
                break
            end
        end
        if not heldEggUid then
            for _, child in ipairs(heldItem.instance:GetDescendants()) do
                if child:IsA("StringValue") and child.Value ~= "" and #child.Value >= 16 then
                    heldEggUid = child.Value
                    break
                end
            end
        end
    end

    local stagingPos = returnPos + Vector3.new(100, 0, 0)

    MystrixHub.Functions.TeleportCharacterTo(stagingPos)
    task.wait(0.15)

    pcall(function()
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Anchored = true
    end)
    task.wait(0.5)
    pcall(function()
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(stagingPos)
    end)
    task.wait(0.1)

    local RS = game:GetService("ReplicatedStorage")
    local remotes = RS:FindFirstChild("Remotes")
    local gameFolder = remotes and remotes:FindFirstChild("Game")
    local BasketDrop = gameFolder and gameFolder:FindFirstChild("BasketDrop")

    local dropped = not MystrixHub.Functions.IsCarryingEgg()
    if BasketDrop and not dropped then
        local dropDeadline = tick() + 10
        while tick() < dropDeadline do
            pcall(function() BasketDrop:FireServer() end)
            task.wait(0.25)
            if not MystrixHub.Functions.IsCarryingEgg() then
                dropped = true
                break
            end
        end
    end

    if not dropped then
        MystrixHub.Functions.KillMountVelocity()
        MystrixHub.Functions.TweenToPosition(returnPos, 30, 4)
        MystrixHub.Functions.KillMountVelocity()
        task.wait(0.5)
        A.ReturningToBase = false
        return true
    end

    task.wait(0.4)

    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then
        A.ReturningToBase = false
        return true
    end

    local targetEgg = nil

    if heldEggUid then
        for _, egg in ipairs(renderedEggs:GetChildren()) do
            if egg:IsA("Model") then
                local uid = MystrixHub.Functions.GetEggUid(egg)
                if uid and uid == heldEggUid then
                    targetEgg = egg
                    break
                end
            end
        end
    end

    if not targetEgg and heldEggName then
        local wantName = heldEggName:match("^([^%[]+)") or heldEggName
        wantName = wantName:match("^%s*(.-)%s*$") or wantName
        local closest, closestDist = nil, math.huge
        for _, egg in ipairs(renderedEggs:GetChildren()) do
            if egg:IsA("Model") then
                local baseName = egg.Name:match("^([^%[]+)") or egg.Name
                baseName = baseName:match("^%s*(.-)%s*$") or baseName
                if baseName:lower() == wantName:lower() then
                    local ok, pivot = pcall(function() return egg:GetPivot().Position end)
                    if ok and pivot then
                        local d = (pivot - stagingPos).Magnitude
                        if d < closestDist and d < 60 then
                            closest = egg
                            closestDist = d
                        end
                    end
                end
            end
        end
        targetEgg = closest
    end

    if not targetEgg then
        local closest, closestDist = nil, math.huge
        for _, egg in ipairs(renderedEggs:GetChildren()) do
            if egg:IsA("Model") then
                local ok, pivot = pcall(function() return egg:GetPivot().Position end)
                if ok and pivot then
                    local d = (pivot - stagingPos).Magnitude
                    if d < closestDist and d < 30 then
                        closest = egg
                        closestDist = d
                    end
                end
            end
        end
        targetEgg = closest
    end

    local picked = false
    if targetEgg then
        targetEgg:SetAttribute("MystrixStaged", true)

        local deadline = tick() + 5
        while tick() < deadline do
            if not targetEgg or not targetEgg.Parent then break end
            if MystrixHub.Functions.IsCarryingEgg() then
                picked = true
                break
            end

            local ok, pivot = pcall(function() return targetEgg:GetPivot().Position end)
            if ok and pivot then
                MystrixHub.Functions.TeleportCharacterTo(pivot + Vector3.new(0, cfg.TravelHoverHeight, 0))
            end

            MystrixHub.Functions.PickupEgg(targetEgg)
            task.wait(0.1)
        end

        if picked then
            targetEgg:SetAttribute("MystrixStaged", nil)
        else
            task.delay(30, function()
                if targetEgg and targetEgg.Parent then
                    targetEgg:SetAttribute("MystrixStaged", nil)
                end
            end)
        end
    end

    MystrixHub.Functions.KillMountVelocity()
    MystrixHub.Functions.TweenToPosition(returnPos, 30, 4)
    MystrixHub.Functions.KillMountVelocity()
    task.wait(0.5)

    A.ReturningToBase = false
    return true
end

function MystrixHub.AutoFarmController.RunOnce()
    local _AF = MystrixHub.AutoFuseController
    if _AF and _AF.Enabled and _AF.Busy then
        return false, "fuse busy"
    end

    local A   = MystrixHub.AutoFarmController
    local FS  = MystrixHub.FarmSettings
    local cfg = A.Config

    local plot = A.CachedPlot
    if not plot or not plot.Parent then
        plot = MystrixHub.Functions.GetMyPlot(true)
        if not plot then return false, "no plot" end
        A.CachedPlot = plot
    end
    A.Plot = plot

    if not A.BaseplatePos then
        A.BaseplatePos = MystrixHub.Functions.GetBaseplatePosition(plot)
    end
    if not A.BaseplatePos then return false, "no baseplate" end

    if MystrixHub.Functions.DeliverCarriedEggIfAny() then
        return true, "delivered carried egg"
    end

    local egg = MystrixHub.Functions.FindBestRetrievableEgg(plot, 1e9)
    if not egg then return false, "no retrievable egg" end

    if MystrixHub.Functions.IsVolcanicEgg(egg.name) then
        return MystrixHub.Functions.RunVolcanoEggFlow(function() return A.Running end)
    end

    local eggAlreadyDipped = MystrixHub.Functions.IsTargetEggAlreadyDipped(egg.model)

    local char = LocalPlayer.Character
    if not char then return false, "no character" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "no root" end

    local eggPos    = egg.model:GetPivot().Position
    local eggTarget = eggPos + Vector3.new(0, cfg.TravelHoverHeight, 0)

    MystrixHub.Functions.KillMountVelocity()
    MystrixHub.Functions.MoveToEgg(eggTarget)
    MystrixHub.Functions.KillMountVelocity()

    local carryOk = false
    local lastTeleportEggPos = nil
    local pickupDeadline = tick() + 12
    for attempt = 1, 15 do
        if not A.Running then return false, "aborted" end
        if tick() > pickupDeadline then break end
        if not egg.model or not egg.model.Parent then break end

        local currentEggPos = egg.model:GetPivot().Position
        local currentTarget = currentEggPos + Vector3.new(0, cfg.TravelHoverHeight, 0)

        local curChar = LocalPlayer.Character
        local curHrp  = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if not curHrp then break end

        local shouldTeleport = (lastTeleportEggPos == nil)
            or ((currentEggPos - lastTeleportEggPos).Magnitude > 3)
        if shouldTeleport then
            MystrixHub.Functions.TeleportCharacterTo(currentTarget)
            lastTeleportEggPos = currentEggPos
            task.wait(0.15)
        end

        MystrixHub.Functions.PickupEgg(egg.model)
        task.wait(0.25)

        if MystrixHub.Functions.IsCarryingEgg() then
            carryOk = true
            break
        end
    end

    if not carryOk then return false, "pickup failed" end

    task.wait(0.5)
    if not MystrixHub.Functions.IsCarryingEgg() then
        return false, "pickup lost"
    end

    if FS.AutoDIP and not eggAlreadyDipped then
        return MystrixHub.Functions.RunGenericVolcanoDip(function() return A.Running end)
    end

    MystrixHub.Functions.ReturnToBase(plot)
    MystrixHub.Functions.FinalizeEggDelivery()

    task.wait(0.5)
    return true
end

function MystrixHub.Functions.StartAutoFarmBestEgg()
    local A = MystrixHub.AutoFarmController
    A.BestEggEnabled = true

    if MystrixHub.IndexController.Enabled then
        WindUI:Notify({
            Title = "Auto Farm",
            Content = "Auto Index has priority — disable it first.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    if MystrixHub.SpecificEggController.Enabled then
        WindUI:Notify({
            Title = "Auto Farm",
            Content = "Specific Egg Farm has priority — disable it first.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    if MystrixHub.RarityFarmController.Enabled then
        WindUI:Notify({
            Title = "Auto Farm",
            Content = "Rarity Farm has priority — disable it first.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    if A.Running then return end

    local plot = MystrixHub.Functions.GetMyPlot(true)
    if not plot then
        WindUI:Notify({
            Title = "Auto Farm", Content = "Could not find your plot.",
            Duration = 4, Icon = "alert-circle",
        })
        return
    end

    A.CachedPlot   = plot
    A.Plot         = plot
    A.BaseplatePos = MystrixHub.Functions.GetBaseplatePosition(plot)
    if not A.BaseplatePos then
        WindUI:Notify({
            Title = "Auto Farm", Content = "Could not find your baseplate.",
            Duration = 4, Icon = "alert-circle",
        })
        return
    end

    A.Running         = true

    A.Loop = task.spawn(function()
        while A.Running do
            local _AF = MystrixHub.AutoFuseController
            if _AF and _AF.Enabled and _AF.Busy then
                task.wait(0.2)
                continue
            end
            local ok, err = pcall(MystrixHub.AutoFarmController.RunOnce)
            if not ok then task.wait(1)
            elseif not err then task.wait(0.5) end
            task.wait(0.15)
        end
        A.Running = false
    end)
    MystrixHub.TasksController.Insert(A.Loop)
end

function MystrixHub.Functions.StopAutoFarmBestEgg(userRequested)
