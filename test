function MystrixHub.IndexRewardController.BuildCategories()
    local C = MystrixHub.IndexRewardController
    if C._categories then return C._categories end

    local okW, HW = pcall(function()
        return require(game:GetService("ReplicatedStorage").Config.Weapon.Helper)
    end)
    local okA, HA = pcall(function()
        return require(game:GetService("ReplicatedStorage").Config.Armor.Helper)
    end)
    local okO, HO = pcall(function()
        return require(game:GetService("ReplicatedStorage").Config.Ore.Helper)
    end)
    if not (okW and okA and okO) then return nil end

    local cats = {}

    if type(HW.GetConfig) == "function" then
        local cfg = HW.GetConfig()
        if type(cfg) == "table" then
            table.insert(cats, { config = cfg, getType = function(id) return "Weapon" end })
        end
    end

    if type(HA.GetConfig) == "function" then
        local cfg = HA.GetConfig()
        if type(cfg) == "table" then
            table.insert(cats, { config = cfg, getType = function(id)
                local ok, t = pcall(HA.GetBigType, id)
                if ok and type(t) == "string" then return t end
                return "Armor"
            end })
        end
    end

    if type(HO.GetConfig) == "function" then
        local cfg = HO.GetConfig()
        if type(cfg) == "table" then
            table.insert(cats, { config = cfg, getType = function(id) return "Ore" end })
        end
    end

    C._categories = cats
    return cats
