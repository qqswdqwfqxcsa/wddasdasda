function MystrixHub.Functions.TweenToPosition(targetPos, speed, arriveRadius)
    local A = MystrixHub.AutoFarmController

    local character = LocalPlayer.Character
    if not character then return false, "aborted" end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, "aborted" end
    local root = humanoid.RootPart
    if not root then return false, "aborted" end

    local startedCarrying = MystrixHub.Functions.IsCarryingEgg()

    local startPos = root.Position
    local dist = (targetPos - startPos).Magnitude
    if dist < (arriveRadius or 3) then
        return true
    end

    local duration  = dist / math.max(speed, 1)
    local startLook = root.CFrame.LookVector

    local oldPlatformStand = humanoid.PlatformStand
    local oldWalkSpeed     = humanoid.WalkSpeed
    local oldAutoRotate    = humanoid.AutoRotate

    humanoid.PlatformStand = true
    humanoid.WalkSpeed     = 0
    humanoid.AutoRotate    = false

    pcall(function()
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    MystrixHub.Functions.SetNoclip(true)

    local finished     = false
    local cancelReason = nil
    local startTick    = tick()
    local deadline     = startTick + duration + 5

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if finished then return end

        if tick() > deadline then
            cancelReason = "timeout"
            finished = true
            return
        end
        if not MystrixHub.Functions.IsAnyFarmRunning() then
            cancelReason = "aborted"
            finished = true
            return
        end
        if startedCarrying and not MystrixHub.Functions.IsCarryingEgg() then
            cancelReason = "broke"
            finished = true
            return
        end

        local elapsed = tick() - startTick
        local alpha   = math.clamp(elapsed / duration, 0, 1)

        local newPos = startPos:Lerp(targetPos, alpha)
        local newCF  = CFrame.new(newPos, newPos + startLook)

        pcall(function()
            root.CFrame = newCF
            root.AssemblyLinearVelocity  = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)

        if alpha >= 1 then
            finished = true
        end
    end)

    A.TweenState = {
        conn             = conn,
        oldPlatformStand = oldPlatformStand,
        oldWalkSpeed     = oldWalkSpeed,
        oldAutoRotate    = oldAutoRotate,
    }

    while not finished do
        if tick() > deadline then break end
        task.wait()
    end

    if not cancelReason then
        pcall(function()
            root.CFrame = CFrame.new(targetPos, targetPos + startLook)
            root.AssemblyLinearVelocity  = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    MystrixHub.Functions.RestoreFromTween()

    if cancelReason then
        return false, cancelReason
    end
    return true
end

function MystrixHub.Functions.GetBaseplatePosition(plot)
    if not plot then return nil end
    local bp = plot:FindFirstChild("Baseplate")
        or plot:FindFirstChild("BasePlate")
        or plot:FindFirstChild("CenterPoint")
    local pos = nil
    if bp and bp:IsA("BasePart") then
        pos = bp.Position
    else
        for _, d in ipairs(plot:GetDescendants()) do
            if d:IsA("BasePart") then
                local n = d.Name:lower()
                if n:find("baseplate") or n == "centerpoint" then
                    pos = d.Position
                    break
                end
            end
        end
    end
    if not pos then
        pos = plot:GetPivot().Position
    end
    return Vector3.new(pos.X, 40316, pos.Z)
end

function MystrixHub.Functions.TeleportCharacterTo(pos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local look = hrp.CFrame.LookVector
    pcall(function()
        hrp.CFrame = CFrame.new(pos, pos + look)
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    local pr = MystrixHub.Functions.GetPetRoot()
    if pr then
        pcall(function()
            pr.CFrame = CFrame.new(pos, pos + look)
            pr.AssemblyLinearVelocity  = Vector3.zero
            pr.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    return true
end

function MystrixHub.Functions.EnsureAtPosition(targetPos, tolerance)
