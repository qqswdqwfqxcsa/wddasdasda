        local ok = MystrixHub.Functions.Sell_TriggerDialogue()

        if not ok then
            fails = fails + 1
            S.Running = false
            task.wait(0.5)
            continue
        end

        local t0 = tick()
        while pet.Parent and tick() - t0 < 4 do
            task.wait(0.1)
        end
        S.Running = false

        if pet.Parent then
            fails = fails + 1
            pcall(function() humanoid:UnequipTools() end)
            task.wait(0.5)
        else
            sold = sold + 1
            fails = 0
            task.wait(0.4)
        end
    end

    S.Running = false

    if savedCFrame then
        local curChar = LocalPlayer.Character
        local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if curHrp then
            pcall(function()
                curHrp.CFrame = savedCFrame
                curHrp.AssemblyLinearVelocity  = Vector3.zero
                curHrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    WindUI:Notify({
        Title    = "Sell",
        Content  = "Sold " .. sold .. " non-favourite pet(s).",
        Duration = 3,
        Icon     = sold > 0 and "check-circle" or "alert-circle",
    })
end

