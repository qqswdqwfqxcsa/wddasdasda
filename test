function MystrixHub.IndexRewardController.TryClaimLevelReward()
    local ok, IndexData = pcall(function()
        return require(game:GetService("ReplicatedStorage").LocalData.IndexData)
    end)
    if not ok then return end

    local ok2, Helper = pcall(function()
        return require(game:GetService("ReplicatedStorage").Config.Index.Helper)
    end)
    if not ok2 then return end

    local data = IndexData.GetData()
    if not data or type(data) ~= "table" then return end

    local level = tonumber(data.level) or 0
    local exp   = tonumber(data.exp)   or 0

    local ok3, needExp = pcall(Helper.GetNeedExp, level + 1)
    if not ok3 then return end
    if type(needExp) ~= "number" then return end
    if needExp <= 0 then return end
    if exp < needExp then return end

    pcall(function() IndexData.TryClaimedLevel() end)
    task.wait(0.8)
end

function MystrixHub.IndexRewardController.TryClaimAll()
    local C = MystrixHub.IndexRewardController

    local ok, IndexData = pcall(function()
        return require(game:GetService("ReplicatedStorage").LocalData.IndexData)
    end)
    if not ok then return end

    local cats = C.BuildCategories()
    if not cats then return end

    for _, cat in ipairs(cats) do
        for id, _ in pairs(cat.config) do
            local idxType = cat.getType(id)

            local isUnlocked = false
            local isClaimed  = false

            pcall(function()
                isUnlocked = IndexData.IsUnlocked(idxType, id) and true or false
            end)
            pcall(function()
                isClaimed = IndexData.IsClaimed(idxType, id) and true or false
            end)

            if isUnlocked and not isClaimed then
                local ok2, claimed = pcall(function() return IndexData.TryClaimedExp(idxType, id) end)
                if ok2 and claimed then
                    task.wait(0.4)
                else
                    task.wait(0.15)
                end
            end
        end
    end

    C.TryClaimLevelReward()
end

