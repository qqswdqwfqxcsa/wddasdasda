function MystrixHub.Functions.StartSpecificEggFarm()
    local S = MystrixHub.SpecificEggController
    local A = MystrixHub.AutoFarmController

    if S.Running then return end

    if MystrixHub.IndexController.Enabled then
        WindUI:Notify({
            Title = "Specific Egg Farm",
            Content = "Auto Index has priority — disable it first.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    if MystrixHub.RarityFarmController.Enabled then
        MystrixHub.RarityFarmController.Enabled = false
        MystrixHub.RarityFarmController.Running = false
        if MystrixHub.RarityFarmController.Loop then
            task.cancel(MystrixHub.RarityFarmController.Loop)
            MystrixHub.RarityFarmController.Loop = nil
        end
        MystrixHub.Functions.RestoreFromTween()
    end

    local selected = S.SelectedEggs
    if not selected or #selected == 0 then
        local dd = MystrixHub.UIController.Drops.SpecificEggs
        if dd then
            local v = dd.Value
            if type(v) == "table" then
                selected = {}
                for _, x in ipairs(v) do table.insert(selected, x) end
            elseif type(v) == "string" and v ~= "" then
                selected = { v }
            end
        end
    end

    if not selected or #selected == 0 then
        WindUI:Notify({
            Title = "Specific Egg Farm",
            Content = "Please select at least one egg from the dropdown first!",
            Duration = 4,
            Icon = "alert-circle",
        })
        return
    end

    S.SelectedEggs = selected

    MystrixHub.Functions.StopAutoFarmBestEgg(false)

    A.Running = true
    S.Running = true
    S.Enabled = true

    S.Loop = task.spawn(function()
        while S.Running do
            local _AF = MystrixHub.AutoFuseController
            if _AF and _AF.Enabled and _AF.Busy then
                task.wait(0.2)
                continue
            end

            local ok, result, reason = pcall(MystrixHub.SpecificEggController.RunOnce)
            if not ok then
                task.wait(1)
            elseif result == false then
                if reason == "no matching egg" then
                    task.wait(1)
                else
                    task.wait(0.5)
                end
            end

            task.wait(0.15)
        end
        S.Running = false
    end)
    MystrixHub.TasksController.Insert(S.Loop)
end

function MystrixHub.Functions.StopSpecificEggFarm()
    local S = MystrixHub.SpecificEggController
    local A = MystrixHub.AutoFarmController

    S.Running = false
    S.Enabled = false
    A.Running = false
    MystrixHub.Functions.RestoreFromTween()

    if S.Loop then
        task.cancel(S.Loop)
        S.Loop = nil
    end

    if A.BestEggEnabled then
        MystrixHub.Functions.StartAutoFarmBestEgg()
    end
end

function MystrixHub.SpecificEggController.FindBestTarget()
    local S = MystrixHub.SpecificEggController
    local selected = S.SelectedEggs
    if not selected or #selected == 0 then return nil end

    local renderedEggs = Workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return nil end

    local selectedLookup = {}
    for _, name in ipairs(selected) do
        selectedLookup[name] = true
    end

    local plot    = MystrixHub.AutoFarmController.CachedPlot
    local plotPos = plot and plot:GetPivot().Position

    local candidates = {}
    for _, eggModel in ipairs(renderedEggs:GetChildren()) do
        if eggModel:IsA("Model") and selectedLookup[eggModel.Name] then
            if MystrixHub.Functions.EggPassesMutationFilter(eggModel, S.SelectedMutations) then
                local rarity = MystrixHub.Functions.GetEggRarityByName(eggModel.Name)
                local tier   = MystrixHub.EggRarityTier[rarity] or 0
                table.insert(candidates, {
                    model  = eggModel,
                    name   = eggModel.Name,
                    rarity = rarity,
                    tier   = tier,
                })
            end
        end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        if plotPos then
            local da = (a.model:GetPivot().Position - plotPos).Magnitude
            local db = (b.model:GetPivot().Position - plotPos).Magnitude
            if da ~= db then return da < db end
        end
        return a.name < b.name
    end)

    return candidates[1]
end

