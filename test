function MystrixHub.Functions.GetFreePlacementPosition(plot)
    local baseplate = plot and plot:FindFirstChild("Baseplate")
    if not baseplate or not baseplate:IsA("BasePart") then return nil end

    local occupied = MystrixHub.Functions.GetPlacedEggPositions(plot)

    local size = baseplate.Size
    local cf   = baseplate.CFrame
    local spacing = 5
    local padding = 3

    local usableX = math.max(size.X - padding * 2, spacing)
    local usableZ = math.max(size.Z - padding * 2, spacing)
    local cols = math.max(math.floor(usableX / spacing), 1)
    local rows = math.max(math.floor(usableZ / spacing), 1)
    local startX = -((cols - 1) * spacing) / 2
    local startZ = -((rows - 1) * spacing) / 2

    for r = 0, rows - 1 do
        for c = 0, cols - 1 do
            local lx = startX + c * spacing
            local lz = startZ + r * spacing
            local world = (cf * CFrame.new(lx, size.Y / 2, lz)).Position
            local flat  = Vector3.new(world.X, 0, world.Z)

            local occupiedFlag = false
            for _, occ in ipairs(occupied) do
                local dx = flat.X - occ.X
                local dz = flat.Z - occ.Z
                if math.sqrt(dx * dx + dz * dz) < spacing * 0.9 then
                    occupiedFlag = true
                    break
                end
            end

            if not occupiedFlag then
                return world
            end
        end
    end

    return nil
end

function MystrixHub.Functions.GatherEggTools()
    local list = {}
