function MystrixHub.Functions.Fuse_PlaceFourPets(fourPets)
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, "no humanoid" end

    pcall(function() humanoid:UnequipTools() end)
    task.wait(0.2)

    local FusionPetPlace = MystrixHub.Functions.Fuse_GetPlaceRemote()
    if not FusionPetPlace then return false, "no remote" end

    for slot = 1, 4 do
        local entry = fourPets[slot]
        if not entry or not entry.tool or not entry.tool.Parent then
            return false, "lost pet " .. slot
        end

        local fs = MystrixHub.Functions.Fuse_GetSlots()
        if fs and fs:FindFirstChild(tostring(slot)) then
            continue
        end

        if entry.tool.Parent ~= char then
            pcall(function() humanoid:EquipTool(entry.tool) end)
            local t0 = tick()
            while entry.tool.Parent ~= char and tick() - t0 < 1 do
                task.wait(0.05)
            end
        end

        pcall(function() FusionPetPlace:FireServer(slot) end)

        local deadline = tick() + 2
        while tick() < deadline do
            local fs2 = MystrixHub.Functions.Fuse_GetSlots()
            if fs2 and fs2:FindFirstChild(tostring(slot)) then
                break
            end
            task.wait(0.05)
        end

        task.wait(0.15)
    end

    pcall(function() humanoid:UnequipTools() end)
    return true
end

function MystrixHub.Functions.Fuse_RunOnce()
    local F = MystrixHub.AutoFuseController
    if not F.Enabled then return false, "disabled" end

    local fs = MystrixHub.Functions.Fuse_GetSlots()
    if not fs then return false, "no slots" end

    local FusionAction = MystrixHub.Functions.Fuse_GetActionRemote()
    if not FusionAction then return false, "no action remote" end

    local status = fs:GetAttribute("FusionStatus")

    if status == "Result" then
        F.Busy = true
        MystrixHub.Functions.Fuse_MoveToCenter()

        if fs:GetAttribute("FusionFailed") == true then
            pcall(function()
                FusionAction:FireServer("Claim", fs:GetAttribute("FusionResultKey"))
            end)
        else
            local FusionResult = LocalPlayer:FindFirstChild("FusionResult")
            local pet = FusionResult and FusionResult:FindFirstChild("Pet")
            if pet then
                pcall(function()
                    FusionAction:FireServer("Claim", pet:GetAttribute("PetKey"))
                end)
            end
        end

        task.wait(1.5)
        F.Busy = false
        return true
    end

    if status == "Waiting" then
        local endsAt = fs:GetAttribute("EndsAt") or 0
        if workspace:GetServerTimeNow() >= endsAt then
            F.Busy = true
            MystrixHub.Functions.Fuse_MoveToCenter()
            pcall(function() FusionAction:FireServer("Fuse") end)
            task.wait(1)
            F.Busy = false
            return true
        end
        return false, "waiting"
    end

    if fs:GetAttribute("Ready") ~= true then
        local four = MystrixHub.Functions.Fuse_SelectFourPets()
        if not four then return false, "not enough pets" end

        F.Busy = true
        MystrixHub.Functions.Fuse_MoveToCenter()

        local ok, err = MystrixHub.Functions.Fuse_PlaceFourPets(four)
        F.Busy = false

        if not ok then return false, err end
        return true
    end

    local fs2 = MystrixHub.Functions.Fuse_GetSlots()
    local attrs = {}
    for i = 1, 4 do
        local c = fs2:FindFirstChild(tostring(i))
        if not c then return false, "slot missing" end
        attrs[i] = {
            PetName       = c:GetAttribute("PetName"),
            PetKey        = c:GetAttribute("PetKey"),
            Weight        = tonumber(c:GetAttribute("Weight")) or 10,
            Mutation      = c:GetAttribute("Mutation"),
            SpawnMutation = c:GetAttribute("SpawnMutation"),
        }
    end

    local okRules, FusionRules = pcall(function()
        return require(game:GetService("ReplicatedStorage").GameServices:WaitForChild("FusionRules"))
    end)
    if not okRules or not FusionRules then return false, "no rules module" end

    local preview = FusionRules.Preview(attrs)
    if not preview then return false, "no preview" end

    local cost = preview.FuseCost or 0
    local cash = MystrixHub.Functions.Fuse_GetCash()
    if cash < cost then
        return false, "not enough cash"
    end

    F.Busy = true
    MystrixHub.Functions.Fuse_MoveToCenter()
    pcall(function() FusionAction:FireServer("Start") end)
    task.wait(1)
    F.Busy = false
    return true
end

function MystrixHub.Functions.Fuse_Loop()
    local F = MystrixHub.AutoFuseController

    while F.Enabled do
        if MystrixHub.AutoFarmController.Running then
            local A = MystrixHub.AutoFarmController
            if A.ReturningToBase then
                task.wait(0.2)
                continue
            end
            if A.TweenState ~= nil then
                task.wait(0.2)
                continue
            end
            if MystrixHub.Functions.IsCarryingEgg() then
                task.wait(0.2)
                continue
            end
        end

        local ok, result = pcall(MystrixHub.Functions.Fuse_RunOnce)
        if not ok then
            task.wait(1)
        elseif result == false then
            task.wait(0.5)
        else
            task.wait(0.3)
        end
    end
    F.Running = false
    F.Loop = nil
end

function MystrixHub.Functions.StartAutoFuse()
    local F = MystrixHub.AutoFuseController
    if F.Running then return end

    if #F.SelectedPets == 0 then
        WindUI:Notify({
            Title   = "Auto Fuse",
            Content = "Select at least one pet first!",
            Duration = 4, Icon = "alert-circle",
        })
        return
    end

    local M = MystrixHub.MainController
    if M.AutoHatchLuck then
        F.WasHatchLuckOn = true
        MystrixHub.Functions.StopAutoHatchLuck()
        pcall(function()
            local d = MystrixHub.UIController.Drops.AutoHatchLuck
            if d and d.SetValue then d:SetValue(false) end
        end)
    else
        F.WasHatchLuckOn = false
    end

    F.Enabled = true
    F.Running = true
    F.Loop = task.spawn(MystrixHub.Functions.Fuse_Loop)
    MystrixHub.TasksController.Insert(F.Loop)

    WindUI:Notify({
        Title   = "Auto Fuse",
        Content = "Started with " .. F.Priority .. " priority.",
        Duration = 3, Icon = "check-circle",
    })
end

function MystrixHub.Functions.StopAutoFuse()
    local F = MystrixHub.AutoFuseController
    F.Enabled = false
    F.Running = false
    if F.Loop then
        task.cancel(F.Loop)
        F.Loop = nil
    end
    if F.WasHatchLuckOn then
        F.WasHatchLuckOn = false
        MystrixHub.Functions.StartAutoHatchLuck()
        pcall(function()
            local d = MystrixHub.UIController.Drops.AutoHatchLuck
            if d and d.SetValue then d:SetValue(true) end
        end)
    end
end

