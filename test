function MystrixHub.Functions.BuildFeedPetList()
    local M = MystrixHub.MainController
    local filter = M.FeedSelectedPets or {}
    local isAll = #filter == 0 or table.find(filter, "All") ~= nil

    local labelList = MystrixHub.Functions.BuildPetListWithLabels()

    if isAll then
        local pets = {}
        for _, entry in ipairs(labelList) do
            table.insert(pets, entry.pet)
        end
        return pets
    end

    local lookup = {}
    for _, entry in ipairs(labelList) do
        lookup[entry.label] = entry.pet
    end

    local result = {}
    for _, label in ipairs(filter) do
        local pet = lookup[label]
        if pet and pet.Parent then
            table.insert(result, pet)
        end
    end
    return result
end

function MystrixHub.Functions.FeedRound(petList, foodEntry)
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return 0 end

    pcall(function() humanoid:EquipTool(foodEntry.tool) end)
    task.wait(0.15)

    local fed = 0
    local petIdx = 1
    local iterations = 0
    local MAX_ITER = 10000

    while iterations < MAX_ITER do
        iterations = iterations + 1

        local amtVal = foodEntry.amountValue
        if not amtVal or not amtVal.Parent then break end
        if amtVal.Value <= 0 then break end
        if #petList == 0 then break end

        if petIdx > #petList then petIdx = 1 end

        local pet = petList[petIdx]
        if not pet or not pet.Parent then
            table.remove(petList, petIdx)
            petIdx = 1
        else
            MystrixHub.Functions.FeedPetOnce(pet)
            fed = fed + 1
            petIdx = petIdx + 1
        end

        task.wait(0.04)
    end

    pcall(function() humanoid:UnequipTools() end)
    task.wait(0.15)

    return fed
end

function MystrixHub.Functions.FeedSelectedPets()
    if not MystrixHub.Functions.IsPlayerOnPlot() then
        WindUI:Notify({
            Title = "Feed", Content = "You must be on your plot to feed pets.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    local petsToFeed = MystrixHub.Functions.BuildFeedPetList()
    if #petsToFeed == 0 then
        WindUI:Notify({
            Title = "Feed", Content = "No matching pets on your plot.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    local foods = MystrixHub.Functions.GetFoodTools()
    if #foods == 0 then
        WindUI:Notify({
            Title = "Feed", Content = "No food in backpack.",
            Duration = 3, Icon = "alert-circle",
        })
        return
    end

    local usable = {}
    for _, f in ipairs(foods) do
        if not (f.noFeedAll and #petsToFeed > 1) then
            table.insert(usable, f)
        end
    end
    if #usable == 0 then usable = foods end

    local totalFed = 0
    for _, foodEntry in ipairs(usable) do
        if not MystrixHub.Functions.IsPlayerOnPlot() then break end
        totalFed = totalFed + MystrixHub.Functions.FeedRound(petsToFeed, foodEntry)
    end

    WindUI:Notify({
        Title = "Feed", Content = "Fed " .. totalFed .. " time(s).",
        Duration = 3, Icon = "check-circle",
    })
end

