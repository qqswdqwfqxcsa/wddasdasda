function MystrixHub.UpgradeController.ResolveKey(sectionName)
    local C = MystrixHub.UpgradeController
    if C._resolvedKeys[sectionName] then return C._resolvedKeys[sectionName] end

    local keywords = C._keywordMap[sectionName]
    if not keywords then return nil end

    local UpgradeData = C.GetUpgradeData()
    if not UpgradeData then return nil end

    local data = UpgradeData.GetData()
    if type(data) ~= "table" then return nil end

    for key, _ in pairs(data) do
        local lk = tostring(key):lower():gsub("[%s_%-]", "")
        for _, kw in ipairs(keywords) do
            local kwNorm = kw:gsub("[%s_%-]", "")
            if lk == kwNorm or lk:find(kwNorm, 1, true) then
                C._resolvedKeys[sectionName] = key
                return key
            end
        end
    end

    return nil
end

