    Title = "Auto Hatch All Eggs Below 0 Weight",
    Desc  = "Weight Filter not set",
    Locked = false,
    Buttons = {},
})

local function UpdateHatchMethodParagraph()
    local M = MystrixHub.MainController
    local method = M.AutoHatchMethod or "Below"
    local slider = tonumber(M.AutoHatchWeightSlider) or 0

    local descText
    local titleText

    if slider <= 0 then
        titleText = "Auto Hatch All Eggs " .. method .. " Weight"
        descText  = "Weight Filter not set"
    else
        local shownValue = slider * 1000
        local valueStr
        if shownValue >= 1e9 then
            valueStr = string.format("%.2fB", shownValue / 1e9)
        elseif shownValue >= 1e6 then
            valueStr = string.format("%.2fM", shownValue / 1e6)
        elseif shownValue >= 1e3 then
            valueStr = string.format("%.2fK", shownValue / 1e3)
        else
            valueStr = tostring(math.floor(shownValue))
        end

        titleText = "Auto Hatch All Eggs " .. method .. " " .. valueStr .. " Weight"
        descText  = "Method: " .. method .. " | Threshold: " .. valueStr
    end

    pcall(function() hatchMethodParagraph:SetTitle(titleText) end)
    pcall(function() hatchMethodParagraph:SetDesc(descText) end)
end

MystrixHub.Functions.UpdateHatchMethodParagraph = UpdateHatchMethodParagraph

