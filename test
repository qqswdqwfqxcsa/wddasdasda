    end,
})

MiscSection:Toggle({
    Title    = "Quick Interact",
    Value    = false,
    Flag     = "QuickInteract",
    Callback = function(state)
        if state then
            MystrixHub.PromptBackup = MystrixHub.PromptBackup or {}
            local backup = MystrixHub.PromptBackup
            local conn
            conn = workspace.DescendantAdded:Connect(function(obj)
                if obj:IsA("ProximityPrompt") then
                    backup[obj] = { hold = obj.HoldDuration, line = obj.RequiresLineOfSight }
                    obj.HoldDuration = 0
                    obj.RequiresLineOfSight = false
                end
            end)
            MystrixHub.QuickInteractConn = conn
            for _, prompt in ipairs(workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    backup[prompt] = { hold = prompt.HoldDuration, line = prompt.RequiresLineOfSight }
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                end
            end
        else
            if MystrixHub.QuickInteractConn then
                MystrixHub.QuickInteractConn:Disconnect()
                MystrixHub.QuickInteractConn = nil
            end

            local backup = MystrixHub.PromptBackup
            if backup then
                for prompt, orig in pairs(backup) do
                    pcall(function()
                        prompt.HoldDuration = orig.hold
                        prompt.RequiresLineOfSight = orig.line
                    end)
                end
                table.clear(backup)
            end
        end
    end,
})

local PerformanceSection = LeftVStack:Section({ Title = "Performance", Icon = "cpu", Box = true, Opened = true })

PerformanceSection:Toggle({
    Title    = "Hide Players",
    Value    = false,
    Flag     = "HidePlayers",
    Callback = function(state)
        local function hide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 1
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = false
                end
            end
        end

        local function unhide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 0
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = true
                end
            end
        end

        if state then
            local playerConns = {}

            local function watch(plr)
                if plr == LocalPlayer then return end
                if playerConns[plr] then playerConns[plr]:Disconnect() end
                hide(plr)
                playerConns[plr] = plr.CharacterAdded:Connect(function() hide(plr) end)
            end

            for _, plr in ipairs(Players:GetPlayers()) do watch(plr) end

            local addConn = Players.PlayerAdded:Connect(watch)
            local removeConn = Players.PlayerRemoving:Connect(function(plr)
                if playerConns[plr] then
                    playerConns[plr]:Disconnect()
                    playerConns[plr] = nil
                end
            end)

            MystrixHub.HidePlayersStuff = { addConn, removeConn, playerConns, unhide }
        else
            if MystrixHub.HidePlayersStuff then
                local stuff = MystrixHub.HidePlayersStuff
                pcall(function() stuff[1]:Disconnect() end)
                pcall(function() stuff[2]:Disconnect() end)
                for _, c in pairs(stuff[3]) do pcall(function() c:Disconnect() end) end
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then pcall(function() stuff[4](plr) end) end
                end
                MystrixHub.HidePlayersStuff = nil
            end
        end
    end,
})

