local SCRIPT_URL = "https://raw.githubusercontent.com/ummarxfarooq/mystrix-hub/refs/heads/main/loader"

MiscSection:Button({
    Title = "Server Hop",
    Icon  = "shuffle",
    Callback = function()
        task.spawn(function()
            local TeleportService = Services.TeleportService
            local servers = {}

            local ok, req = pcall(function()
                return game:HttpGet(
                    "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                    "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
                )
            end)

            if not ok or not req then
                WindUI:Notify({
                    Title = "Server Hop",
                    Content = "Failed to fetch server list.",
                    Duration = 3,
                    Icon = "alert-circle",
                })
                return
            end

            local body
            local ok2, decoded = pcall(function() return HttpService:JSONDecode(req) end)
            if ok2 then body = decoded end

            if body and body.data then
                for _, v in next, body.data do
                    if type(v) == "table"
                        and tonumber(v.playing)
                        and tonumber(v.maxPlayers)
                        and v.playing < v.maxPlayers
                        and v.id ~= game.JobId
                    then
                        table.insert(servers, 1, v.id)
                    end
                end
            end

            if #servers == 0 then
                WindUI:Notify({
                    Title = "Server Hop",
                    Content = "Couldn't find a server.",
                    Duration = 3,
                    Icon = "alert-circle",
                })
                return
            end

            if SCRIPT_URL == "" or SCRIPT_URL:find("YOUR_USER") then
                WindUI:Notify({
                    Title = "Server Hop",
                    Content = "SCRIPT_URL is not set — script won't auto-execute on the new server.",
                    Duration = 5,
                    Icon = "alert-triangle",
                })
            else
                local qot = queue_on_teleport
                    or (syn and syn.queue_on_teleport)
                    or (fluxus and fluxus.queue_on_teleport)

                if qot then
                    local exec = "loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()"
                    pcall(qot, exec)
                else
                    WindUI:Notify({
                        Title = "Server Hop",
                        Content = "Your executor doesn't support queue_on_teleport — you'll need to re-execute manually.",
                        Duration = 5,
                        Icon = "alert-triangle",
                    })
                end
            end

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                servers[math.random(1, #servers)],
                Players.LocalPlayer
            )
        end)
    end,
})

