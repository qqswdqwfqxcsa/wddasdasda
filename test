local PET_SPEED_ANCHORS = {
    { Walk = 50,  Shown = 15 },
    { Walk = 55,  Shown = 300 },
    { Walk = 100, Shown = 5000 },
    { Walk = 180, Shown = 1000000 },
    { Walk = 200, Shown = 100000000 },
    { Walk = 210, Shown = 300000000 },
    { Walk = 240, Shown = 1000000000 },
    { Walk = 300, Shown = 1000000000000 },
}

function MystrixHub.Functions.ShownToWalkSpeed(shown)
    shown = tonumber(shown) or 0
    if shown <= 0 then return nil end
    if shown <= PET_SPEED_ANCHORS[1].Shown then
        return PET_SPEED_ANCHORS[1].Walk
    end
    for i = 1, #PET_SPEED_ANCHORS - 1 do
        local a = PET_SPEED_ANCHORS[i]
        local b = PET_SPEED_ANCHORS[i + 1]
        if shown <= b.Shown then
            local t = (math.log10(shown) - math.log10(a.Shown))
                    / (math.log10(b.Shown) - math.log10(a.Shown))
            return a.Walk + t * (b.Walk - a.Walk)
        end
    end
    return PET_SPEED_ANCHORS[#PET_SPEED_ANCHORS].Walk
end

function MystrixHub.Functions.GetPetWalkSpeed(petModel)
    if not petModel then return nil end

    local data = petModel:FindFirstChild("Data")

    if data then
        for _, name in ipairs({"WalkSpeed", "BaseSpeed", "Speed"}) do
            local v = data:FindFirstChild(name)
            if v and v:IsA("ValueBase") then
                local n = tonumber(v.Value)
                if n and n > 0 and n < 1000 then
                    return n
                end
            end
        end
    end

    local PetsModule = MystrixHub.Functions.LoadPetsModule()
    if PetsModule and PetsModule[petModel.Name] then
        local s = tonumber(PetsModule[petModel.Name].Speed)
        if s and s > 0 then return s end
    end

    if data then
        local v = data:FindFirstChild("Speed")
        if v and v:IsA("ValueBase") then
            local shown = tonumber(v.Value)
            if shown and shown > 0 then
                return MystrixHub.Functions.ShownToWalkSpeed(shown)
            end
        end
    end

    return nil
end

function MystrixHub.Functions.LoadAssetsDirectory()
    local A = MystrixHub.AutoFarmController
    if A.AssetsDir then return A.AssetsDir end

    local RS = game:GetService("ReplicatedStorage")
    local candidates = {
        RS:FindFirstChild("Data"),
        RS:FindFirstChild("GameData"),
        RS,
    }

    for _, parent in ipairs(candidates) do
        if parent then
            local mod = parent:FindFirstChild("Assets")
            if mod and mod:IsA("ModuleScript") then
                local ok, r = pcall(require, mod)
                if ok and type(r) == "table" then
                    local dir = r.Directory or r
                    if next(dir) then
                        A.AssetsDir = dir
                        return dir
                    end
                end
            end
        end
    end
    return nil
end

function MystrixHub.Functions.GetEggSortScore(name)
    local eggs = MystrixHub.Functions.GetGameEggs()
