function MystrixHub.Functions.SellSelectedRarities()
    local S = MystrixHub.SellController

    if not S.SelectedRarities or #S.SelectedRarities == 0 then
        WindUI:Notify({
            Title    = "Sell",
            Content  = "Select at least one rarity first!",
            Duration = 3,
            Icon     = "alert-circle",
        })
        return
    end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    pcall(function() humanoid:UnequipTools() end)
    task.wait(0.3)

    local pets = MystrixHub.Functions.Sell_FindPetsByRarity(S.SelectedRarities)
    if #pets == 0 then
        WindUI:Notify({
            Title    = "Sell",
            Content  = "No pets of the selected rarities in your backpack.",
            Duration = 3,
            Icon     = "alert-circle",
        })
        return
    end

    MystrixHub.Functions.Sell_InstallHook()

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local savedCFrame = hrp and hrp.CFrame

    local seller = MystrixHub.Functions.Sell_GetSeller()
    if seller then
        local prim = seller.PrimaryPart or seller:FindFirstChildWhichIsA("BasePart")
        if prim and hrp then
            local target = prim.Position + (prim.CFrame.LookVector * -3) + Vector3.new(0, 3, 0)
            pcall(function()
                hrp.CFrame = CFrame.new(target)
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            task.wait(0.4)
        end
    end

    local sold = 0
    local fails = 0
    local MAX_FAILS = 5

    while fails < MAX_FAILS do
        local current = MystrixHub.Functions.Sell_FindPetsByRarity(S.SelectedRarities)
        if #current == 0 then
            break
        end

        local pet = current[1]

        pcall(function() humanoid:EquipTool(pet) end)
        task.wait(0.5)

        if pet.Parent ~= char then
            fails = fails + 1
            task.wait(0.5)
            continue
        end

        S.PendingMode = "single"
        S.Running = true
        local ok = MystrixHub.Functions.Sell_TriggerDialogue()

        if not ok then
            fails = fails + 1
            S.Running = false
            task.wait(0.5)
            continue
        end

        local t0 = tick()
        while pet.Parent and tick() - t0 < 4 do
            task.wait(0.1)
        end
        S.Running = false

        if pet.Parent then
            fails = fails + 1
            pcall(function() humanoid:UnequipTools() end)
            task.wait(0.5)
        else
            sold = sold + 1
            fails = 0
            task.wait(0.4)
        end
    end

    S.Running = false

    if savedCFrame then
        local curChar = LocalPlayer.Character
        local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if curHrp then
            pcall(function()
                curHrp.CFrame = savedCFrame
                curHrp.AssemblyLinearVelocity  = Vector3.zero
                curHrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    WindUI:Notify({
        Title    = "Sell",
        Content  = "Sold " .. sold .. " pet(s).",
        Duration = 3,
        Icon     = sold > 0 and "check-circle" or "alert-circle",
    })
