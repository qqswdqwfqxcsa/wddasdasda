            elseif typeof(entryPos) == "CFrame" then ePos = entryPos.Position end

            if ePos and (ePos - pos).Magnitude < 30 then
                return entry:GetAttribute("VolcanoDipped") == true
            end
        end
    end
    return false
end

function MystrixHub.Functions.FormatEggWeight(realWeight)
    realWeight = tonumber(realWeight)
    if not realWeight then return nil end

    local anchors = MystrixHub.EggWeightAnchors
    local shown

    if realWeight <= anchors[1].Real then
        shown = anchors[1].Shown
    else
        shown = anchors[#anchors].Shown
        for i = 1, #anchors - 1 do
            local a = anchors[i]
            local b = anchors[i + 1]
            if realWeight <= b.Real then
                local t = (realWeight - a.Real) / (b.Real - a.Real)
                local lg = math.log10(a.Shown) + (math.log10(b.Shown) - math.log10(a.Shown)) * t
                shown = 10 ^ lg
                break
            end
        end
    end

    if shown >= 1e12 then
        return string.format("%.2fT", shown / 1e12)
    elseif shown >= 1e9 then
        return string.format("%.2fB", shown / 1e9)
    elseif shown >= 1e6 then
        return string.format("%.2fM", shown / 1e6)
    elseif shown >= 1e3 then
        return string.format("%.2fK", shown / 1e3)
    else
        return string.format("%.2f", shown)
    end
end

