function MystrixHub.Functions.RunVolcanoEggFlow(runningCheck)
    local A   = MystrixHub.AutoFarmController
    local cfg = A.Config

    MystrixHub.Functions.SetNoclip(true)
    MystrixHub.Functions.KillMountVelocity()

    local SPECIAL = MystrixHub.VolcanoController.SpecialTweenSpeed
    local wps     = MystrixHub.VolcanoController.Waypoints

    local function goTo(wp, mode)
        if mode == "special" then
            MystrixHub.Functions.TweenToPosition(wp, SPECIAL, 3)
        else
            MystrixHub.Functions.TeleportCharacterTo(wp)
            task.wait(0.15)
        end
        MystrixHub.Functions.KillMountVelocity()
    end

    local function goToVerified(wp, mode)
        local ok = false
        for _ = 1, 3 do
            goTo(wp, mode)
            if MystrixHub.Functions.EnsureAtPosition(wp, 10) then
                ok = true
                break
            end
            MystrixHub.Functions.KillMountVelocity()
            MystrixHub.Functions.TeleportCharacterTo(wp)
            task.wait(0.2)
            if MystrixHub.Functions.EnsureAtPosition(wp, 10) then
                ok = true
                break
            end
        end
        return ok
    end

    for i, wp in ipairs(wps) do
        if runningCheck and not runningCheck() then
            MystrixHub.Functions.SetNoclip(false)
            return false, "aborted"
        end
        if i == 2 or i == 3 then
            goToVerified(wp, "special")
        else
            goToVerified(wp, "normal")
        end
    end

    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then
        MystrixHub.Functions.SetNoclip(false)
        return false, "no rendered eggs"
    end

    local eggModel
    for _, e in ipairs(renderedEggs:GetChildren()) do
        if e:IsA("Model") and MystrixHub.Functions.IsVolcanicEgg(e.Name) then
            eggModel = e
            break
        end
    end
    if not eggModel then
        MystrixHub.Functions.SetNoclip(false)
        return false, "no volcanic egg"
    end

    local eggPos    = eggModel:GetPivot().Position
    local eggTarget = eggPos + Vector3.new(0, cfg.TravelHoverHeight, 0)

    MystrixHub.Functions.KillMountVelocity()
    MystrixHub.Functions.TeleportCharacterTo(eggTarget)
    task.wait(0.15)
    MystrixHub.Functions.KillMountVelocity()

    local carryOk = false
    local lastTP  = nil
    local pickupDeadline = tick() + 12
    for _ = 1, 15 do
        if runningCheck and not runningCheck() then
            MystrixHub.Functions.SetNoclip(false)
            return false, "aborted"
        end
        if tick() > pickupDeadline then break end
        if not eggModel or not eggModel.Parent then break end

        local cur = eggModel:GetPivot().Position
        local tgt = cur + Vector3.new(0, cfg.TravelHoverHeight, 0)

        if lastTP == nil or (cur - lastTP).Magnitude > 3 then
            MystrixHub.Functions.TeleportCharacterTo(tgt)
            lastTP = cur
            task.wait(0.15)
        end

        MystrixHub.Functions.PickupEgg(eggModel)
        task.wait(0.25)

        if MystrixHub.Functions.IsCarryingEgg() then
            carryOk = true
            break
        end
    end

    if not carryOk then
        MystrixHub.Functions.SetNoclip(false)
        return false, "pickup failed"
    end

    task.wait(0.5)
    if not MystrixHub.Functions.IsCarryingEgg() then
        MystrixHub.Functions.SetNoclip(false)
        return false, "pickup lost"
    end

    for i = #wps, 1, -1 do
        if runningCheck and not runningCheck() then break end
        if i == 1 or i == 2 or i == 3 then
            goToVerified(wps[i], "special")
        else
            goToVerified(wps[i], "normal")
        end
    end

    do
        local topWp = wps[1]
        local ensureDeadline = tick() + 4
        while not MystrixHub.Functions.EnsureAtPosition(topWp, 15) and tick() < ensureDeadline do
            if runningCheck and not runningCheck() then break end
            MystrixHub.Functions.KillMountVelocity()
            MystrixHub.Functions.TeleportCharacterTo(topWp)
            task.wait(0.2)
        end
        MystrixHub.Functions.KillMountVelocity()
    end

    if MystrixHub.FarmSettings.AutoDIP then
        if runningCheck and not runningCheck() then
            MystrixHub.Functions.SetNoclip(false)
            return false, "aborted"
        end

        local CS = game:GetService("CollectionService")
        local volcanoTop = nil
        local ok, tagged = pcall(function() return CS:GetTagged("VolcanoTop") end)
        if ok and tagged then
            for _, part in ipairs(tagged) do
                if typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace) then
                    volcanoTop = part
                    break
                end
            end
        end

        if volcanoTop then
            local dipPos = volcanoTop.Position + Vector3.new(0, volcanoTop.Size.Y / 2 + 30, 0)

            local RS = game:GetService("ReplicatedStorage")
            local netPkg = RS:FindFirstChild("packages")
            local net = netPkg and netPkg:FindFirstChild("Net")
            local resultEvent    = net and net:FindFirstChild("RE/VolcanoDipResult")
            local cancelledEvent = net and net:FindFirstChild("RE/VolcanoDipCancelled")
            local dipRemote      = net and net:FindFirstChild("RE/VolcanoDip")

            if dipRemote then
                local resultPayload = nil
                local cancelled     = false
                local conn1, conn2

                if resultEvent and resultEvent:IsA("RemoteEvent") then
                    conn1 = resultEvent.OnClientEvent:Connect(function(payload)
                        if type(payload) == "table" and payload.Owner == LocalPlayer.UserId then
                            resultPayload = payload
                        end
                    end)
                end
                if cancelledEvent and cancelledEvent:IsA("RemoteEvent") then
                    conn2 = cancelledEvent.OnClientEvent:Connect(function(payload)
                        if type(payload) == "table" and payload.Owner == LocalPlayer.UserId then
                            cancelled = true
                        end
                    end)
                end

                MystrixHub.Functions.KillMountVelocity()
                MystrixHub.Functions.TeleportCharacterTo(dipPos)
                task.wait(0.15)
                MystrixHub.Functions.KillMountVelocity()

                local function anchorAtDip()
                    local c = LocalPlayer.Character
                    local h = c and c:FindFirstChild("HumanoidRootPart")
                    if not h then return end
                    pcall(function()
                        h.AssemblyLinearVelocity  = Vector3.zero
                        h.AssemblyAngularVelocity = Vector3.zero
                        h.CFrame   = CFrame.new(dipPos)
                        h.Anchored = true
                    end)
                end

                local function unanchorFromDip()
                    local c = LocalPlayer.Character
                    local h = c and c:FindFirstChild("HumanoidRootPart")
                    if h then
                        pcall(function()
                            h.Anchored = false
                            h.AssemblyLinearVelocity  = Vector3.zero
                            h.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end

                anchorAtDip()
                task.wait(0.3)

                local fireDeadline = tick() + 12
                while MystrixHub.Functions.IsCarryingEgg() and tick() < fireDeadline do
                    if runningCheck and not runningCheck() then break end
                    pcall(function() dipRemote:FireServer() end)
                    anchorAtDip()
                    task.wait(0.2)
                end

                local startT   = tick()
                local MAX_HOLD = 30
                local minEnd   = nil

                while tick() - startT < MAX_HOLD do
                    if runningCheck and not runningCheck() then break end

                    anchorAtDip()

                    if resultPayload and not minEnd then
                        local arriveAt = tonumber(resultPayload.ArriveAt)
                        local remaining = 0
                        if arriveAt then
                            remaining = arriveAt - workspace:GetServerTimeNow()
                        end
                        if remaining < 2 then remaining = 2 end
                        minEnd = tick() + remaining
                    end

                    if minEnd and tick() >= minEnd then
                        break
                    end

                    task.wait(0.05)
                end

                unanchorFromDip()

                if not resultPayload and MystrixHub.Functions.IsCarryingEgg() then
                    local forceDeadline = tick() + 5
                    while tick() < forceDeadline and MystrixHub.Functions.IsCarryingEgg() do
                        if runningCheck and not runningCheck() then break end
                        pcall(function() dipRemote:FireServer() end)
                        task.wait(0.25)
                        if resultPayload then break end
                    end
                end

                if conn1 then conn1:Disconnect() end
                if conn2 then conn2:Disconnect() end

                if resultPayload then
                    if resultPayload.Success and resultPayload.Mutation == "Magma" then
                        WindUI:Notify({
                            Title    = "Magma Obtained!",
                            Content  = "Dipped Volcanic Egg and got Magma!",
                            Duration = 8, Icon = "flame",
                        })
                    else
                        WindUI:Notify({
                            Title    = "Volcano Dip",
                            Content  = "No Magma this time.",
                            Duration = 3, Icon = "info",
                        })
                    end
                elseif cancelled then
                    WindUI:Notify({
                        Title    = "Volcano Dip",
                        Content  = "Dip cancelled.",
                        Duration = 3, Icon = "alert-circle",
                    })
                end
            end
        end
    end

    local plot = A.CachedPlot or MystrixHub.Functions.GetMyPlot(true)
    MystrixHub.Functions.ReturnToBase(plot)
    MystrixHub.Functions.FinalizeEggDelivery()

    MystrixHub.Functions.SetNoclip(false)
    task.wait(2)
    return true
end

