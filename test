function MystrixHub.Functions.FindBestRarityTarget()
    local R = MystrixHub.RarityFarmController
    if not R.SelectedRarities or #R.SelectedRarities == 0 then return nil end

    local renderedEggs = Workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return nil end

    local wanted = {}
    for _, r in ipairs(R.SelectedRarities) do wanted[r] = true end

    local plot    = MystrixHub.AutoFarmController.CachedPlot
    local plotPos = plot and plot:GetPivot().Position

    local candidates = {}
    for _, eggModel in ipairs(renderedEggs:GetChildren()) do
        if eggModel:IsA("Model") then
            local name   = eggModel.Name
            local rarity = MystrixHub.Functions.GetEggRarityByName(name)
            if wanted[rarity] then
                if MystrixHub.Functions.EggPassesMutationFilter(eggModel, R.SelectedMutations) then
                    local tier, luck = MystrixHub.Functions.GetEggSortScore(name)
                    table.insert(candidates, {
                        model      = eggModel,
                        name       = name,
                        rarity     = rarity,
                        tier       = tier,
                        luck       = luck,
                        isEthereal = (rarity == "Ethereal"),
                    })
                end
            end
        end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        if a.luck ~= b.luck then return a.luck > b.luck end
        if plotPos then
            local da = (a.model:GetPivot().Position - plotPos).Magnitude
            local db = (b.model:GetPivot().Position - plotPos).Magnitude
            if da ~= db then return da < db end
        end
        return a.name < b.name
    end)

    return candidates[1]
end

function MystrixHub.RarityFarmController.RunOnce()
    local _AF = MystrixHub.AutoFuseController
    if _AF and _AF.Enabled and _AF.Busy then
        return false, "fuse busy"
    end

    local R   = MystrixHub.RarityFarmController
    local A   = MystrixHub.AutoFarmController
    local FS  = MystrixHub.FarmSettings
    local cfg = A.Config

    local plot = A.CachedPlot
    if not plot or not plot.Parent then
        plot = MystrixHub.Functions.GetMyPlot(true)
        if not plot then return false, "no plot" end
        A.CachedPlot = plot
    end
    A.Plot = plot

    if not A.BaseplatePos then
        A.BaseplatePos = MystrixHub.Functions.GetBaseplatePosition(plot)
    end
    if not A.BaseplatePos then return false, "no baseplate" end

    if MystrixHub.Functions.DeliverCarriedEggIfAny() then
        return true, "delivered carried egg"
    end

    local target = MystrixHub.Functions.FindBestRarityTarget()
    if not target then return false, "no matching egg" end

    if MystrixHub.Functions.IsVolcanicEgg(target.name) then
        return MystrixHub.Functions.RunVolcanoEggFlow(function() return R.Running end)
    end

    local eggAlreadyDipped = MystrixHub.Functions.IsTargetEggAlreadyDipped(target.model)

    local char = LocalPlayer.Character
    if not char then return false, "no character" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "no root" end

    local eggPos    = target.model:GetPivot().Position
    local eggTarget = eggPos + Vector3.new(0, cfg.TravelHoverHeight, 0)

    MystrixHub.Functions.KillMountVelocity()
    MystrixHub.Functions.MoveToEgg(eggTarget)
    MystrixHub.Functions.KillMountVelocity()

    local carryOk = false
    local lastTeleportEggPos = nil
    local pickupDeadline = tick() + 12
    for attempt = 1, 15 do
        if not R.Running then return false, "aborted" end
        if tick() > pickupDeadline then break end
        if not target.model or not target.model.Parent then break end

        local currentEggPos = target.model:GetPivot().Position
        local currentTarget = currentEggPos + Vector3.new(0, cfg.TravelHoverHeight, 0)

        local curChar = LocalPlayer.Character
        local curHrp  = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if not curHrp then break end

        local shouldTeleport = (lastTeleportEggPos == nil)
            or ((currentEggPos - lastTeleportEggPos).Magnitude > 3)
        if shouldTeleport then
            MystrixHub.Functions.TeleportCharacterTo(currentTarget)
            lastTeleportEggPos = currentEggPos
            task.wait(0.15)
        end

        MystrixHub.Functions.PickupEgg(target.model)
        task.wait(0.25)

        if MystrixHub.Functions.IsCarryingEgg() then
            carryOk = true
            break
        end
    end

    if not carryOk then return false, "pickup failed" end

    task.wait(0.5)
    if not MystrixHub.Functions.IsCarryingEgg() then
        return false, "pickup lost"
    end

    if FS.AutoDIP and not eggAlreadyDipped then
        return MystrixHub.Functions.RunGenericVolcanoDip(function() return R.Running end)
    end

    MystrixHub.Functions.ReturnToBase(plot)

    pcall(function()
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:UnequipTools() end
    end)

    task.wait(2)
    return true
end

function MystrixHub.Functions.StartAutoIndex()
    local I = MystrixHub.IndexController
    local A = MystrixHub.AutoFarmController
    local S = MystrixHub.SpecificEggController

    if I.Running then return end

    I.WasBestEnabled     = A.BestEggEnabled
    I.WasSpecificEnabled = S.Enabled

    MystrixHub.Functions.StopAutoFarmBestEgg(false)
    MystrixHub.Functions.StopSpecificEggFarm()

    A.Running = true
    I.Running = true
    I.Enabled = true

    I.Loop = task.spawn(function()
        while I.Running do
            local _AF = MystrixHub.AutoFuseController
            if _AF and _AF.Enabled and _AF.Busy then
                task.wait(0.2)
                continue
            end

            local ok, result, reason = pcall(MystrixHub.IndexController.RunOnce)
            if not ok then
                task.wait(1)
            elseif result == false then
                if reason == "no matching egg" then
                    task.wait(1)
                else
                    task.wait(0.5)
                end
            end

            task.wait(0.15)
        end
        I.Running = false
    end)
    MystrixHub.TasksController.Insert(I.Loop)
end

function MystrixHub.Functions.StopAutoIndex()
    local I = MystrixHub.IndexController
    local A = MystrixHub.AutoFarmController
    local S = MystrixHub.SpecificEggController

    I.Running = false
    I.Enabled = false
    A.Running = false
    MystrixHub.Functions.RestoreFromTween()

    if I.Loop then
        task.cancel(I.Loop)
        I.Loop = nil
    end

    if I.WasSpecificEnabled then
        MystrixHub.Functions.StartSpecificEggFarm()
    elseif I.WasBestEnabled or A.BestEggEnabled then
        MystrixHub.Functions.StartAutoFarmBestEgg()
    end
end

