    MystrixHub.UIController.FPSTag = MystrixHub.UIController.Window:Tag({ Title = "FPS: --", Color = MystrixHub.UIController.CurrentAccent })
    local lastUpdate = tick()
    local frameCount = 0
    MystrixHub.UIController.FPSConnection = RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastUpdate >= 1 then
            local fps = math.floor(frameCount / (now - lastUpdate))
            MystrixHub.UIController.FPSTag:SetTitle("FPS: " .. fps)
            frameCount = 0
            lastUpdate = now
        end
    end)
end

