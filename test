function MystrixHub.Functions.StartAutoWheelie()
    local M = MystrixHub.MainController
    if M.AutoWheelie then return end
    M.AutoWheelie = true
    M.AutoWheelieThrottle = 1
    M.AutoWheelieBrake = 0
    M.AutoWheelieAllow0 = false
    M.AutoWheeliePulse = 0
    M.AutoWheelieLastT = nil
    M.AutoWheelieLastB = nil
    M.AutoWheelieMounted = false
    M.AutoWheelieRay = RaycastParams.new()
    M.AutoWheelieRay.FilterType = Enum.RaycastFilterType.Exclude
    M.AutoWheelieRay.IgnoreWater = true

    local UserInputService = game:GetService("UserInputService")
    local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local loopDt = mobile and 0.05 or 0.03
    local rayStride = mobile and 4 or 1

    local RS = game:GetService("ReplicatedStorage")
    local SR = RS:WaitForChild("ScooterRemotes")
    local ScooterInput = SR:WaitForChild("ScooterInput")

    if M.AutoWheelieConn then M.AutoWheelieConn:Disconnect() M.AutoWheelieConn = nil end

    if not M.AutoWheelieHook then
        M.AutoWheelieHook = true
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if M.AutoWheelie and M.AutoWheelieMounted then
                if method == "SetAttribute" and self == LocalPlayer then
                    local args = {...}
                    local name, value = args[1], args[2]
                    if name == "ScooterLocalWheelie" then
                        if value == 0 and not M.AutoWheelieAllow0 then
                            args[2] = 1
                        end
                    elseif name == "ScooterLocalThrottle" then
                        args[2] = M.AutoWheelieThrottle
                    elseif name == "ScooterLocalBrake" then
                        args[2] = M.AutoWheelieBrake
                    end
                    return oldNamecall(self, table.unpack(args))
                end

                if method == "FireServer" and self == ScooterInput then
                    local args = {...}
                    if typeof(args[1]) == "table" then
                        args[1].wheelie   = M.AutoWheelieAllow0 and 0 or 1
                        args[1].throttle  = M.AutoWheelieThrottle
                        args[1].brake     = M.AutoWheelieBrake
                    end
                    return oldNamecall(self, table.unpack(args))
                end
            end

            return oldNamecall(self, ...)
        end))
    end

    if M.AutoWheelieRender then M.AutoWheelieRender:Disconnect() end
    M.AutoWheelieRender = RunService.RenderStepped:Connect(function()
        if M.AutoWheeliePulse == 1 then
            M.AutoWheeliePulse = 2
            M.AutoWheelieAllow0 = false
            pcall(function() LocalPlayer:SetAttribute("ScooterLocalWheelie", 1) end)
        elseif M.AutoWheeliePulse == 2 then
            M.AutoWheeliePulse = 0
        end
    end)
    MystrixHub.ConnectionController.Insert(M.AutoWheelieRender)

    if M.AutoWheelieLoop then task.cancel(M.AutoWheelieLoop) end
    M.AutoWheelieLoop = task.spawn(function()
        local wasMounted = false
        local prevPitch = 0
        local pulseAccum = 0
        local frameIdx = 0

        while M.AutoWheelie do
            frameIdx = frameIdx + 1
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local weld = hrp and hrp:FindFirstChild("ScooterMountWeld")

            if weld then
                if not wasMounted then
                    wasMounted = true
                    prevPitch = 0
                    pulseAccum = 0.9
                    M.AutoWheelieAllow0 = false
                    M.AutoWheeliePulse = 0
                    M.AutoWheelieMounted = false
                    task.wait(0.4)
                    M.AutoWheelieMounted = true
                end

                local scooter = weld.Part0 and weld.Part0:FindFirstAncestorOfClass("Model")
                local pitch = 0
                local roll = 0
                local surfacePenalty = 0

                if scooter then
                    local body = scooter:FindFirstChild(scooter:GetAttribute("DriveRootName") or "Body")
                    if body then
                        local look = body.CFrame.LookVector
                        pitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
                        local right = body.CFrame.RightVector
                        roll = math.deg(math.asin(math.clamp(right.Y, -1, 1)))

                        if frameIdx % rayStride == 0 then
                            M.AutoWheelieRay.FilterDescendantsInstances = { char, scooter }
                            local hit = workspace:Raycast(body.Position, Vector3.new(0, -8, 0), M.AutoWheelieRay)
                            if hit then
                                local mat = hit.Instance.Material
                                if mat == Enum.Material.Grass or mat == Enum.Material.LeafyGrass
                                   or mat == Enum.Material.Mud or mat == Enum.Material.Sand
                                   or mat == Enum.Material.Snow or mat == Enum.Material.Ground then
                                    surfacePenalty = 6
                                end
                            end
                        end
                    end
                end

                local rollPenalty = math.min(15, math.abs(roll) * 0.35)
                local effPitch = pitch + rollPenalty

                local dt = loopDt
                local vel = (pitch - prevPitch) / dt
                prevPitch = pitch
                local predicted = effPitch + vel * 0.15 + surfacePenalty

                local newT, newB
                if predicted > 74 or effPitch > 74 then
                    newT, newB = 0, 1
                elseif predicted > 68 or effPitch > 68 then
                    newT, newB = 0, 0.55
                elseif predicted > 60 or effPitch > 60 then
                    newT, newB = 0.1, 0.2
                elseif predicted > 50 or effPitch > 50 then
                    newT, newB = 0.3, 0
                elseif predicted > 30 or effPitch > 30 then
                    newT, newB = 0.6, 0
                else
                    newT, newB = 1, 0
                end

                M.AutoWheelieThrottle = newT
                M.AutoWheelieBrake = newB

                if M.AutoWheelieLastT ~= newT then
                    M.AutoWheelieLastT = newT
                    pcall(function() LocalPlayer:SetAttribute("ScooterLocalThrottle", newT) end)
                end
                if M.AutoWheelieLastB ~= newB then
                    M.AutoWheelieLastB = newB
                    pcall(function() LocalPlayer:SetAttribute("ScooterLocalBrake", newB) end)
                end

                pulseAccum = pulseAccum + dt
                if pulseAccum >= 1.2 and pitch < 40 and M.AutoWheeliePulse == 0 then
                    pulseAccum = 0
                    M.AutoWheeliePulse = 1
                    M.AutoWheelieAllow0 = true
                    pcall(function() LocalPlayer:SetAttribute("ScooterLocalWheelie", 0) end)
                end
            else
                if wasMounted then
                    wasMounted = false
                    M.AutoWheelieMounted = false
                    M.AutoWheelieAllow0 = false
                    M.AutoWheeliePulse = 0
                    M.AutoWheelieThrottle = 0
                    M.AutoWheelieBrake = 0
                    M.AutoWheelieLastT = nil
                    M.AutoWheelieLastB = nil
                end
            end

            task.wait(loopDt)
        end
    end)
    MystrixHub.TasksController.Insert(M.AutoWheelieLoop)
end

