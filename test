function MystrixHub.FrostTowerController.GetMaxWave()
    local ok, helper = pcall(function() return require(game:GetService("ReplicatedStorage").Config.Dungeon.Helper) end)
    if not ok or type(helper) ~= "table" then return 30 end
    local ok2, cfg = pcall(function() return helper.GetConfig() end)
    if not ok2 or type(cfg) ~= "table" then return 30 end
    return #cfg
end

function MystrixHub.FrostTowerController.GetNearestEnemy()
    local LocalPlayer = game.Players.LocalPlayer
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local EnemyFolder = workspace:FindFirstChild("EnemyFolder")
    if not EnemyFolder then return nil end

    local nearest, nearestDist = nil, math.huge
    for _, enemy in ipairs(EnemyFolder:GetChildren()) do
        if enemy:IsA("Model") and not enemy:GetAttribute("Dead") then
            local ep = enemy.PrimaryPart or enemy:FindFirstChild("HumanoidRootPart")
            if ep then
                local d = (ep.Position - hrp.Position).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearest = enemy
                end
            end
        end
    end
    return nearest
end

function MystrixHub.FrostTowerController.StartTeleportLoop()
    local C = MystrixHub.FrostTowerController
    if C._teleportLoop then return end
    C._teleportLoop = task.spawn(function()
        while C.Running do
            local enemy = C.GetNearestEnemy()
            if enemy then
                local LocalPlayer = game.Players.LocalPlayer
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local ep  = enemy.PrimaryPart or enemy:FindFirstChild("HumanoidRootPart")
                    if hrp and ep then
                        local offset = hrp.Position - ep.Position
                        if offset.Magnitude < 0.1 then offset = Vector3.new(0, 0, 1) end
                        local target = ep.Position + offset.Unit * 4
                        pcall(function()
                            hrp.CFrame = CFrame.new(target.X, target.Y, target.Z)
                            hrp.AssemblyLinearVelocity  = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end
            end
            task.wait(0.15)
        end
        C._teleportLoop = nil
    end)
end

function MystrixHub.FrostTowerController.StartAttackLoop()
    local C = MystrixHub.FrostTowerController
    if C._attackLoop then return end
    local ok, CommUtils = pcall(function()
        return require(game:GetService("ReplicatedStorage").Utils.CommunicationUtils)
    end)
    if not ok then return end
    local ATKOnceBE = CommUtils.TryGetBindableEvent("Attack", "ATKOnceBE")
    if not ATKOnceBE then return end

    C._attackLoop = task.spawn(function()
        while C.Running do
            pcall(function() ATKOnceBE:Fire() end)
            task.wait(0.1)
        end
        C._attackLoop = nil
    end)
end

function MystrixHub.FrostTowerController.ForceIKGMOn()
    local C = MystrixHub.FrostTowerController
    C._forcedIKPrev = MystrixHub.InstantKillController.Enabled
    C._forcedGMPrev = MystrixHub.GodModeController.Enabled

    if not MystrixHub.InstantKillController._hooked then
        MystrixHub.Functions.StartInstantKill()
    else
        MystrixHub.InstantKillController.Enabled = true
    end
    if not MystrixHub.GodModeController._hooked then
        MystrixHub.Functions.StartGodMode()
    else
        MystrixHub.GodModeController.Enabled = true
    end
end

function MystrixHub.FrostTowerController.RestoreIKGM()
    local C = MystrixHub.FrostTowerController
    MystrixHub.InstantKillController.Enabled = C._forcedIKPrev or false
    MystrixHub.GodModeController.Enabled     = C._forcedGMPrev or false
end

function MystrixHub.FrostTowerController.InstallHook()
    local C = MystrixHub.FrostTowerController
    if C._hooked then return true end
    local DungeonData = C.GetDungeonData()
    if not DungeonData or type(DungeonData.CompleteRound) ~= "function" then
        WindUI:Notify({ Title = "Frost Tower", Content = "Failed to load DungeonData module.", Duration = 4, Icon = "alert-circle" })
        return false
    end
    C._origComplete = DungeonData.CompleteRound
    DungeonData.CompleteRound = function(round, ...)
        local a, b = C._origComplete(round, ...)
        C.LastCompletedWave = tonumber(round) or 0
        return a, b
    end
    C._hooked = true
    return true
end

function MystrixHub.FrostTowerController.WaitForWaveEnd()
    local C = MystrixHub.FrostTowerController
    local LocalPlayer = game.Players.LocalPlayer
    local DungeonData = C.GetDungeonData()
    if not DungeonData then return end

    local currentWave = C.CurrentWave
    local roundTimer  = tick()

    while C.Running and LocalPlayer:GetAttribute("Dungeoning") do
        task.wait(0.4)

        if C.LastCompletedWave >= currentWave then
            local nextWave = currentWave + 1
            if not C.AllMode and not table.find(C.WantedWaves, nextWave) then
                task.wait(0.8)
                pcall(function() DungeonData.ExitDungeon() end)
                local tx = tick()
                while LocalPlayer:GetAttribute("Dungeoning") and tick() - tx < 8 do
                    task.wait(0.3)
                end
                return
            end
            if C.AllMode and currentWave >= C.GetMaxWave() then
                pcall(function() DungeonData.ExitDungeon() end)
                local tx = tick()
                while LocalPlayer:GetAttribute("Dungeoning") and tick() - tx < 8 do
                    task.wait(0.3)
                end
                return
            end
            currentWave = nextWave
            roundTimer  = tick()
        end

        if tick() - roundTimer > 60 then
            pcall(function() DungeonData.ExitDungeon() end)
            return
        end
    end
end

function MystrixHub.FrostTowerController.RunIteration()
    local C = MystrixHub.FrostTowerController
    local LocalPlayer = game.Players.LocalPlayer
    local DungeonData = C.GetDungeonData()
    if not DungeonData then return end

    local waves = {}
    if C.AllMode then
        table.insert(waves, 1)
    else
        for _, r in ipairs(C.WantedWaves) do
            table.insert(waves, r)
        end
        if #waves == 0 then table.insert(waves, 1) end
    end

    for _, startWave in ipairs(waves) do
        if not C.Running then return end

        if LocalPlayer:GetAttribute("Dungeoning") then
            C.WaitForWaveEnd()
        end

        if not C.Running then return end

        C.LastCompletedWave = 0
        C.CurrentWave       = startWave

        pcall(function() DungeonData.TryIntoDungeon(startWave) end)

        local t0 = tick()
        while C.Running and tick() - t0 < 20 do
            if LocalPlayer:GetAttribute("Dungeoning") then break end
            task.wait(0.3)
        end

        if not LocalPlayer:GetAttribute("Dungeoning") then
            task.wait(2)
            continue
        end

        task.wait(1)
        C.WaitForWaveEnd()
        task.wait(2)
    end
end

function MystrixHub.Functions.StartFrostTowerFarm()
    local C = MystrixHub.FrostTowerController
    if C.Running then return end

    local tickets = C.GetTicketCount()
    C._currentTickets = tickets

    if tickets == nil then
        WindUI:Notify({
            Title = "Frost Tower",
            Content = "Could not read your tower ticket count.",
            Duration = 4,
            Icon = "alert-circle",
        })
        return
    end

    if tickets <= 0 then
        WindUI:Notify({
            Title = "Frost Tower",
            Content = "You don't have enough tower tickets.",
            Duration = 4,
            Icon = "alert-circle",
        })
        return
    end

    if not C.InstallHook() then return end

    C.Enabled = true
    C.Running = true

    C.ForceIKGMOn()
    C.StartTeleportLoop()
    C.StartAttackLoop()

    C.Loop = task.spawn(function()
        while C.Running do
            if (C._currentTickets or 0) <= 0 then
                WindUI:Notify({
                    Title = "Frost Tower",
                    Content = "Out of tower tickets — auto farm stopped.",
                    Duration = 4,
                    Icon = "alert-circle",
                })
                break
            end
            local ok, err = pcall(C.RunIteration)
            if not ok then
                warn("[FrostTower] " .. tostring(err))
                task.wait(2)
            end
            task.wait(0.5)
        end
        C.Running = false
        C.Enabled = false
        C.StopTeleportLoop()
        C.StopAttackLoop()
        C.RestoreIKGM()
    end)
    MystrixHub.TasksController.Insert(C.Loop)
end

function MystrixHub.Functions.StopFrostTowerFarm()
    local C = MystrixHub.FrostTowerController
    C.Enabled = false
    C.Running = false
    if C.Loop then
        task.cancel(C.Loop)
        C.Loop = nil
    end
    C.RestoreIKGM()
    pcall(function()
        if game.Players.LocalPlayer:GetAttribute("Dungeoning") then
            require(game:GetService("ReplicatedStorage").LocalData.DungeonData).ExitDungeon()
        end
    end)
end

