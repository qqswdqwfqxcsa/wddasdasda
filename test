function MystrixHub.AutoTrainController.TeleportToSpawn()
    local C = MystrixHub.AutoTrainController
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local TranslateUtils = C.GetTranslateUtils()
    if TranslateUtils and type(TranslateUtils.ToSpawn) == "function" then
        local ok = pcall(function() TranslateUtils.ToSpawn(char) end)
        if ok then return end
    end

    local spawn = C.GetSpawnPart()
    if spawn then
        pcall(function()
            hrp.CFrame = spawn.CFrame + Vector3.new(0, 5, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

function MystrixHub.AutoTrainController.Tick()
    local C = MystrixHub.AutoTrainController

    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local best = C.FindBestTreadmill()
    if not best then return end

    local part = C.GetTreadmillPart(best.id)
    if part then
        local targetPos
        if part:IsA("BasePart") then
            targetPos = part.Position + Vector3.new(0, 5, 0)
        elseif part:IsA("Model") then
            targetPos = part:GetPivot().Position + Vector3.new(0, 5, 0)
        end
        if targetPos then
            local dist = (hrp.Position - targetPos).Magnitude
            if dist > 12 then
                pcall(function()
                    hrp.CFrame = CFrame.new(targetPos)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
                task.wait(0.25)
            end
        end
    end

    local TrainCTRL = C.GetTrainCTRL()
    if TrainCTRL and type(TrainCTRL.TrainOnce) == "function" then
        pcall(TrainCTRL.TrainOnce)
    end
end

function MystrixHub.Functions.StartAutoTrain()
    local C = MystrixHub.AutoTrainController
    if C.Running then return end

    local best = C.FindBestTreadmill()
    if not best then
        WindUI:Notify({
            Title    = "Auto Train",
            Content  = "No accessible treadmill found for your current rebirth.",
            Duration = 4,
            Icon     = "alert-circle",
        })
        return
    end

    C.Enabled = true
    C.Running = true

    C.Loop = task.spawn(function()
        while C.Running do
            local ok, err = pcall(C.Tick)
            if not ok then
                warn("[AutoTrain] " .. tostring(err))
            end
            task.wait(C.Interval)
        end
        C.Running = false
    end)
    MystrixHub.TasksController.Insert(C.Loop)
end

function MystrixHub.Functions.StopAutoTrain()
    local C = MystrixHub.AutoTrainController
    C.Enabled = false
    C.Running = false
    if C.Loop then
        task.cancel(C.Loop)
        C.Loop = nil
    end
    C.TeleportToSpawn()
end

