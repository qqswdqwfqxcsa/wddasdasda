function MystrixHub.UpgradeController.GetCoinValue()
    local LocalPlayer = game.Players.LocalPlayer
    local paths = {
        { "Eco", "coin" },
        { "Eco", "Coin" },
        { "Eco", "coins" },
        { "Eco", "Coins" },
        { "Stats", "coin" },
        { "Leaderstats", "Coin" },
    }
    for _, path in ipairs(paths) do
        local node = LocalPlayer
        local ok = true
        for _, name in ipairs(path) do
            local ok2, child = pcall(function() return node:WaitForChild(name, 0.1) end)
            if not ok2 or not child then
                ok = false
                break
            end
            node = child
        end
        if ok and node and node:IsA("ValueBase") then
            local v = tonumber(node.Value)
            if v then return v end
        end
        if ok and node and type(node) == "number" then
            return node
        end
    end
    return nil
end

function MystrixHub.UpgradeController.TryUpgradeSection(sectionName)
    local C = MystrixHub.UpgradeController
    if not C.Flags[sectionName] then return end

    local key = C.ResolveKey(sectionName)
    if not key then return end

    local UpgradeData = C.GetUpgradeData()
    if not UpgradeData then return end

    local Helper = C.GetUpgradeHelper()
    if not Helper then return end

    local level = tonumber(UpgradeData.GetLevel(key)) or 0

    if type(Helper.CheckIsMax) == "function" then
        local ok, isMax = pcall(Helper.CheckIsMax, key, level)
        if ok and isMax then return end
    end

    local price = nil
    if type(Helper.GetPrice) == "function" then
        local ok, p = pcall(Helper.GetPrice, key, level + 1)
        if ok then price = tonumber(p) end
    end

    if not price or price <= 0 then return end

    local coin = C.GetCoinValue()
    if coin == nil then return end
    if coin < price then return end

    pcall(function() UpgradeData.UpgradeOnce(key) end)
    task.wait(0.5)

    local newLevel = tonumber(UpgradeData.GetLevel(key)) or level
    if newLevel > level then
        WindUI:Notify({
            Title    = sectionName .. " Upgraded",
            Content  = string.format("Level %d -> %d", level, newLevel),
            Duration = 2,
            Icon     = "arrow-up-circle",
        })
    end
end

