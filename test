function MystrixHub.Functions.Fuse_GatherEligiblePets()
    local F = MystrixHub.AutoFuseController
    if #F.SelectedPets == 0 then return {} end

    local wanted = {}
    for _, name in ipairs(F.SelectedPets) do
        wanted[name:lower()] = true
    end

    local list = {}
    local seen = {}
    local containers = {
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer.Character,
    }
    for _, cont in ipairs(containers) do
        if cont then
            for _, item in ipairs(cont:GetChildren()) do
                if item:IsA("Tool") and item:HasTag("Pet") and not seen[item] then
                    seen[item] = true
                    if item:GetAttribute("Favorited") ~= true then
                        local baseName = item:GetAttribute("PetName")
                        if not baseName or baseName == "" then
                            baseName = item.Name:match("^([^%[]+)")
                            if baseName then baseName = baseName:match("^%s*(.-)%s*$") end
                            baseName = baseName or item.Name
                        end
                        if wanted[baseName:lower()] then
                            local val = MystrixHub.Functions.Fuse_GetPetValue(baseName)
                            local weight = tonumber(item:GetAttribute("Weight")) or 0
                            table.insert(list, {
                                tool = item,
                                name = baseName,
                                petKey = item:GetAttribute("PetKey"),
                                value = val,
                                weight = weight,
                            })
                        end
                    end
                end
            end
        end
    end
    return list
end

function MystrixHub.Functions.Fuse_SelectFourPets()
    local F = MystrixHub.AutoFuseController
    local pool = MystrixHub.Functions.Fuse_GatherEligiblePets()
    if #pool < 4 then return nil, "not enough pets" end

    table.sort(pool, function(a, b)
        if a.value ~= b.value then
            if F.Priority == "Minimum Value" then
                return a.value < b.value
            else
                return a.value > b.value
            end
        end
        if a.weight ~= b.weight then
            if F.Priority == "Minimum Value" then
                return a.weight < b.weight
            else
                return a.weight > b.weight
            end
        end
        return tostring(a.petKey) < tostring(b.petKey)
    end)

    local chosen = {}
    for i = 1, 4 do
        chosen[i] = pool[i]
    end
    return chosen
end

