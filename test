function MystrixHub.Functions.IsEggTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if tool:GetAttribute("EggKey") or tool:GetAttribute("Egg") then return true end
    local baseName = tool.Name:match("^([^%[]+)")
    if baseName then baseName = baseName:match("^%s*(.-)%s*$") end
    if baseName and baseName:match(" Egg$") then return true end
    return false
end

function MystrixHub.Functions.RefreshGameData()
    local C = MystrixHub.GameDataCache

    if C.Eggs and C.Pets then return true end
    if C.LastRefresh > 0 and (C.Eggs or C.Pets) then return true end

    local RS = game:GetService("ReplicatedStorage")
    local gd = RS:FindFirstChild("GameData")

    if gd then
        if not C.Eggs then
            local eggsMod = gd:FindFirstChild("Eggs")
            if eggsMod and eggsMod:IsA("ModuleScript") then
                local ok, r = pcall(require, eggsMod)
                if ok and type(r) == "table" and next(r) then
                    C.Eggs = r
                end
            end
        end

        if not C.Pets then
            local petsMod = gd:FindFirstChild("Pets")
            if petsMod and petsMod:IsA("ModuleScript") then
                local ok, r = pcall(require, petsMod)
                if ok and type(r) == "table" and next(r) then
                    C.Pets = r
                end
            end
        end
    end

    C.LastRefresh = os.time()
    return (C.Eggs ~= nil) or (C.Pets ~= nil)
end

function MystrixHub.Functions.GetGameEggs()
    local C = MystrixHub.GameDataCache
    if not C.Eggs then MystrixHub.Functions.RefreshGameData() end

    local merged = {}
    if C.Eggs then
        for k, v in pairs(C.Eggs) do merged[k] = v end
    end
    for k, v in pairs(MystrixHub.FallbackEggs) do
        if not merged[k] then merged[k] = v end
