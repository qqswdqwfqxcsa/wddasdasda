ConfigSection:Button({
    Title    = "Export Config",
    Icon     = "upload",
    Callback = function()
        task.spawn(function()
            local configName = MystrixHub.ConfigController.SelectedConfig
            if not configName or configName == "" or configName == "No configs found" then
                WindUI:Notify({ Title = "Export Failed", Content = "Please select a config from the dropdown first!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local configPath = MystrixHub.Meta.FolderPath .. "/Config/" .. configName .. ".json"
            local fallbackPath = MystrixHub.Meta.FolderPath .. "/Configs/" .. configName .. ".json"
            
            local filePath = nil
            if isfile and isfile(configPath) then
                filePath = configPath
            elseif isfile and isfile(fallbackPath) then
                filePath = fallbackPath
            else
                local ok, content = pcall(readfile, configPath)
                if ok and content and content ~= "" then
                    filePath = configPath
                else
                    local ok2, content2 = pcall(readfile, fallbackPath)
                    if ok2 and content2 and content2 ~= "" then
                        filePath = fallbackPath
                    end
                end
            end

            if not filePath then
                WindUI:Notify({ Title = "Export Failed", Content = "Config file not found. Make sure you've saved it at least once.", Duration = 4, Icon = "alert-circle" })
                return
            end

            local raw = nil
            local ok, content = pcall(readfile, filePath)
            if ok and content and content ~= "" then raw = content end

            if not raw then
                WindUI:Notify({ Title = "Export Failed", Content = "Could not read config file content.", Duration = 3, Icon = "alert-circle" })
                return
            end

            local encoded = HttpService:JSONEncode({
                mhub = true,
                v    = MystrixHub.Meta.Version,
                name = configName,
                data = raw,
            })

            if setclipboard then
                setclipboard(encoded)
                WindUI:Notify({
                    Title    = "Config Exported!",
                    Content  = "'" .. configName .. "' copied to clipboard.",
                    Duration = 4,
                    Icon     = "clipboard-check",
                })
            else
                WindUI:Notify({ Title = "No Clipboard", Content = "Your executor does not support setclipboard().", Duration = 3, Icon = "alert-circle" })
            end
        end)
    end,
})

