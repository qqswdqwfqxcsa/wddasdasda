local function BuildOreNameMap()
    local nameToId = {}
    local idToName = {}
    local oreFolder = game:GetService("ReplicatedStorage").Assets:FindFirstChild("Ore")
    if not oreFolder then return nameToId, idToName end
    local ok, oreHelper = pcall(function()
        return require(game:GetService("ReplicatedStorage").Config.Ore.Helper)
    end)
    local ids = {}
    for _, child in ipairs(oreFolder:GetChildren()) do
        if child:IsA("Model") then
            table.insert(ids, child.Name)
        end
    end
    table.sort(ids, function(a, b)
        return (tonumber(a:match("%d+")) or 0) < (tonumber(b:match("%d+")) or 0)
    end)
    for _, id in ipairs(ids) do
        local display = id
        if ok and oreHelper.GetDisName then
            local ok2, n = pcall(oreHelper.GetDisName, id)
            if ok2 and type(n) == "string" and n ~= "" then
                display = n
            end
        end
        if nameToId[display] then
            display = display .. " (" .. id .. ")"
        end
        nameToId[display] = id
        idToName[id] = display
    end
    return nameToId, idToName
end

