PerformanceSection:Toggle({
    Title    = "Hide Players",
    Value    = false,
    Flag     = "HidePlayers",
    Callback = function(state)
        local function hide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 1
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = false
                end
            end
        end

        local function unhide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 0
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = true
                end
            end
        end

        if state then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then hide(plr) end
            end
            local addConn = Players.PlayerAdded:Connect(function(plr)
                if plr ~= LocalPlayer then
                    hide(plr)
                    plr.CharacterAdded:Connect(function() hide(plr) end)
                end
            end)
            local respawnConns = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local c = plr.CharacterAdded:Connect(function() hide(plr) end)
                    table.insert(respawnConns, c)
                end
            end
            MystrixHub.HidePlayersStuff = { addConn, respawnConns }
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then unhide(plr) end
            end
            if MystrixHub.HidePlayersStuff then
                MystrixHub.HidePlayersStuff[1]:Disconnect()
                for _, c in ipairs(MystrixHub.HidePlayersStuff[2]) do c:Disconnect() end
                MystrixHub.HidePlayersStuff = nil
            end
        end
    end,
})

