function MystrixHub.AutoTrainController.CanAccess(id, entry, rebirth, PemData)
    if entry.IsPay then
        if PemData and type(PemData.isHavePem) == "function" then
            local ok, has = pcall(PemData.isHavePem, "AutoTrainArea_" .. tostring(id))
            if ok and has then return true end
        end
        return false
    end
    local need = entry.NeedRebirth or 0
    return rebirth >= need
end

function MystrixHub.AutoTrainController.FindBestTreadmill()
    local C = MystrixHub.AutoTrainController
    local cfg = C.GetConfig()
    if not cfg then return nil end
    local rebirth = C.GetRebirthValue()
    if not rebirth then return nil end
    local PemData = C.GetPemData()

    local best = nil
    for id, entry in pairs(cfg) do
        if C.CanAccess(id, entry, rebirth, PemData) then
            local basic = entry.Basic or 0
            if not best or basic > best.basic then
                best = { id = id, basic = basic }
            end
        end
    end
    return best
end

function MystrixHub.AutoTrainController.GetTreadmillPart(id)
    local root = workspace:FindFirstChild("TOUCHED")
    root = root and root:FindFirstChild("AutoTrainArea")
    if not root then return nil end
    return root:FindFirstChild(tostring(id))
end

function MystrixHub.AutoTrainController.GetSpawnPart()
    local candidates = {
        workspace:FindFirstChild("SpawnLocation"),
        workspace:FindFirstChild("Spawn"),
        workspace.WorldModel and workspace.WorldModel:FindFirstChild("Spawn"),
        workspace.WorldModel and workspace.WorldModel:FindFirstChild("SpawnLocation"),
    }
    for _, p in ipairs(candidates) do
        if p and p:IsA("BasePart") then return p end
    end
    return nil
end

