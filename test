    return names
end

function MystrixHub.Functions.GetFoodTools()
    local foods = {}
    local FoodsModule = MystrixHub.Functions.LoadFoodsModule()
    if not FoodsModule then return foods end

    local CS = game:GetService("CollectionService")
    local seen = {}

    local function hasFoodTag(item)
        local ok, r = pcall(function() return item:HasTag("Food") end)
        if ok and r then return true end
        local ok2, r2 = pcall(function() return CS:HasTag(item, "Food") end)
        return ok2 and r2
    end

    local function scan(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and not seen[item] and hasFoodTag(item) then
                seen[item] = true
                if FoodsModule[item.Name] then
                    local data = item:FindFirstChild("Data")
                    local amountVal = data and data:FindFirstChild("Amount")
                    local amt = amountVal and tonumber(amountVal.Value) or 0
                    if amt > 0 then
                        table.insert(foods, {
                            tool         = item,
                            name         = item.Name,
                            amountValue  = amountVal,
                            xp           = FoodsModule[item.Name].XP or 0,
                            noFeedAll    = FoodsModule[item.Name].NoFeedAll == true,
                        })
                    end
                end
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("Backpack"))
    scan(LocalPlayer.Character)

    table.sort(foods, function(a, b)
        if a.xp ~= b.xp then return a.xp > b.xp end
        return a.name < b.name
    end)

    return foods
end

