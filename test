function MystrixHub.Functions.GetPetSpeedRaw(pet)
    if not pet then return "0" end
    local speedFolder = pet:FindFirstChild("PetSpeed")
    if not speedFolder then return "0" end
    local speedLabel = speedFolder:FindFirstChild("Speed")
    if not speedLabel then return "0" end
    return tostring(speedLabel.Text)
end

function MystrixHub.Functions.ParseSpeedValue(rawText)
    if type(rawText) ~= "string" then return 0 end

    local cleaned = rawText:gsub("[%s,]", "")

    local num, suffix = cleaned:match("^([%d%.]+)(%a+)")
    if not num then
        num = cleaned:match("^([%d%.]+)")
        suffix = nil
    end

    local n = tonumber(num)
    if not n then return 0 end

    if suffix then
        local mult = PET_SPEED_SUFFIXES[suffix]
        if mult then
            return n * mult
        end
    end
    return n
end

function MystrixHub.Functions.BuildPetListWithLabels()
    local pets = MystrixHub.Functions.GetAllPetsInPlot()
    local list = {}

    for _, pet in ipairs(pets) do
        local base = (pet.Name:match("^([^%[]+)") or pet.Name):match("^%s*(.-)%s*$") or pet.Name
        local raw  = MystrixHub.Functions.GetPetSpeedRaw(pet)
        local score = MystrixHub.Functions.ParseSpeedValue(raw)
        table.insert(list, {
            pet   = pet,
            base  = base,
            raw   = raw,
            score = score,
        })
    end

    table.sort(list, function(a, b)
        if a.score ~= b.score then return a.score > b.score end
        if a.base  ~= b.base  then return a.base  < b.base  end
        return tostring(a.pet) < tostring(b.pet)
    end)

    local used = {}
    for _, entry in ipairs(list) do
        local baseLabel = string.format("[ %s ] %s", entry.raw, entry.base)
        local label = baseLabel
        local n = 1
        while used[label] do
            n = n + 1
            label = baseLabel .. " #" .. n
        end
        used[label] = true
        entry.label = label
    end

    return list
end

function MystrixHub.Functions.GetPetDisplayNames()
    local names = { "All" }
    for _, entry in ipairs(MystrixHub.Functions.BuildPetListWithLabels()) do
