local PET_SPEED_SUFFIXES = {
    K  = 1e3,
    M  = 1e6,
    B  = 1e9,
    T  = 1e12,
    Qa = 1e15,
    Qi = 1e18,
    Sx = 1e21,
    Sp = 1e24,
