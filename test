function MystrixHub.Functions.EggSpawnWebhook_Tick()
    local C = MystrixHub.EggSpawnWebhookController
    if not C.Enabled or #C.Filter == 0 then return end

    local filterLookup = {}
    for _, n in ipairs(C.Filter) do
        if type(n) == "string" and n ~= "" then
            filterLookup[n:lower()] = true
        end
    end

    local mutLookup = {}
    local mutAny = false
    for _, m in ipairs(C.MutationFilter) do
        if type(m) == "string" then
            if m == "Any" then mutAny = true end
            mutLookup[m:lower()] = true
        end
    end

    local rendered = workspace:FindFirstChild("RenderedEggs")
    if not rendered then return end

    for _, eggModel in ipairs(rendered:GetChildren()) do
        if eggModel:IsA("Model") and not C.Tracked[eggModel] then
            C.Tracked[eggModel] = true

            local eggName = eggModel.Name
            if filterLookup[eggName:lower()] then
                local mutation = "None"
                local muts = MystrixHub.Functions.GetEggMutations(eggModel)
                if muts and #muts > 0 then mutation = muts[1] end

                local mutOk = mutAny or mutLookup[mutation:lower()] == true
                if mutOk then
                    task.spawn(function()
                        MystrixHub.Functions.SendEggSpawnWebhook(eggName, mutation)
                    end)
                end
            end
        end
    end

    for inst in pairs(C.Tracked) do
        if not inst.Parent then C.Tracked[inst] = nil end
    end
end

function MystrixHub.Functions.StartEggSpawnWebhook()
    local C = MystrixHub.EggSpawnWebhookController
